# Copie este arquivo para ".env" e preencha com seus dados.
# O arquivo .env NÃO vai para o GitHub (está no .gitignore).

PORT=3000
NODE_ENV=development

# Segredo usado para assinar o cookie da sessão (use um texto longo e aleatório)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Cria as tabelas + dados de exemplo automaticamente se o banco estiver vazio
DB_AUTO_INIT=true

# ---------------------------------------------------------------
# OPÇÃO A) MySQL local (testes offline)
# ---------------------------------------------------------------
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=allocate_db

# ---------------------------------------------------------------
# OPÇÃO B) PostgreSQL (Render ou Postgres local)
# Comente o bloco do MySQL acima e descomente as linhas abaixo.
# No Render, DATABASE_URL é preenchida automaticamente pelo render.yaml.
# ---------------------------------------------------------------
# DB_CLIENT=postgres
# DATABASE_URL=postgresql://usuario:senha@host:5432/allocate_db
# DB_SSL=true   # necessário ao usar a "External Database URL" do Render
