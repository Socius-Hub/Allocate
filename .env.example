# Copie este arquivo para ".env" e preencha com seus dados
PORT=8081
NODE_ENV=development

# Segredo usado para assinar o cookie da sessão (use um texto longo e aleatório)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Conexão com o PostgreSQL
# Local:  postgres://USUARIO:SENHA@localhost:5432/allocate_db
# Render: use a "External Database URL" do painel e defina DB_SSL=true
DATABASE_URL=postgres://postgres:sua_senha@localhost:5432/allocate_db

# SSL na conexão com o banco (true para o banco do Render; em produção já é ativado sozinho)
DB_SSL=false

# Cria as tabelas + dados de exemplo automaticamente se o banco estiver vazio
DB_AUTO_INIT=true

# MySQL local (testes offiline) 
DB_HOST=localhost
DB_USER=root
DB_PASSWORD="senha_mysql"
DB_DATABASE=allocate_db
DB_PORT=3306

