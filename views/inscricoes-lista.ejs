<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-background text-on-background font-body-md antialiased">

<%- include('partials/menu-lateral') %>

<div class="md:ml-64 min-h-screen flex flex-col">
  <%- include('partials/cabecalho') %>

  <main class="flex-1 mt-20 p-margin-mobile md:p-margin-desktop w-full max-w-[1600px] mx-auto">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-lg">
      <div><h2 class="font-display-lg-mobile md:font-display-lg text-on-surface">Lista de Inscrições</h2><p class="font-body-lg text-on-surface-variant mt-xs">Histórico completo e gestão de status de inscrições em eventos.</p></div>
      <a href="/inscricao-nova" class="flex items-center gap-xs px-md py-2 bg-primary text-on-primary font-label-md text-label-md rounded-lg hover:bg-tertiary transition-colors shadow-sm"><span class="material-symbols-outlined text-[18px]">add</span>Nova Inscrição</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter mb-xl">
      <div class="md:col-span-3 bg-surface-container-lowest rounded-xl p-md border border-outline-variant shadow-sm flex flex-wrap gap-sm items-center">
        <span class="font-label-md text-label-md text-on-surface-variant mr-sm">Filtros de Status:</span>
        <button class="px-md py-xs rounded-full bg-surface-container-high text-on-surface font-label-sm">Todos</button>
        <button class="px-md py-xs rounded-full bg-surface-container-lowest text-on-surface font-label-sm border border-outline-variant flex items-center gap-xs"><span class="w-2 h-2 rounded-full bg-secondary-container"></span>Solicitada</button>
        <button class="px-md py-xs rounded-full bg-surface-container-lowest text-on-surface font-label-sm border border-outline-variant flex items-center gap-xs"><span class="w-2 h-2 rounded-full bg-primary"></span>Aprovada</button>
        <button class="px-md py-xs rounded-full bg-surface-container-lowest text-on-surface font-label-sm border border-outline-variant flex items-center gap-xs"><span class="w-2 h-2 rounded-full bg-tertiary"></span>Paga</button>
        <button class="px-md py-xs rounded-full bg-surface-container-lowest text-on-surface font-label-sm border border-outline-variant flex items-center gap-xs"><span class="w-2 h-2 rounded-full bg-error"></span>Rejeitada</button>
      </div>
      <div class="bg-primary-container rounded-xl p-md shadow-sm flex flex-col justify-center min-h-[100px]">
        <p class="font-label-sm text-on-primary-container/80">Total de Inscrições (Mês)</p>
        <p class="font-headline-md text-headline-md text-on-primary-container">1.248</p>
      </div>
    </div>

    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead><tr class="bg-surface-container-lowest border-b border-outline-variant">
            <th class="py-sm px-md font-label-sm text-on-surface-variant">ID</th><th class="py-sm px-md font-label-sm text-on-surface-variant">Colaborador</th><th class="py-sm px-md font-label-sm text-on-surface-variant">Evento</th><th class="py-sm px-md font-label-sm text-on-surface-variant">Data</th><th class="py-sm px-md font-label-sm text-on-surface-variant">Valor</th><th class="py-sm px-md font-label-sm text-on-surface-variant">Status</th>
          </tr></thead>
          <tbody class="font-body-sm text-body-sm divide-y divide-outline-variant/30">
            <tr class="hover:bg-surface-container-low/50 transition-colors">
              <td class="py-md px-md text-on-surface font-medium">#INS-2024-0891</td>
              <td class="py-md px-md text-on-surface">Ana Flávia Costa</td>
              <td class="py-md px-md text-on-surface-variant">Congresso Brasileiro de Cardiologia</td>
              <td class="py-md px-md text-on-surface-variant">12/10/2024</td>
              <td class="py-md px-md text-on-surface-variant">R$ 1.250,00</td>
              <td class="py-md px-md"><span class="inline-flex items-center px-2 py-1 rounded-full bg-[#fef0c7] text-[#b54708] border border-[#fec84b] font-label-sm">Solicitada</span></td>
            </tr>
            <tr class="hover:bg-surface-container-low/50 transition-colors">
              <td class="py-md px-md text-on-surface font-medium">#INS-2024-0885</td>
              <td class="py-md px-md text-on-surface">Roberto Carlos Mendes</td>
              <td class="py-md px-md text-on-surface-variant">Simpósio de Gestão Hospitalar</td>
              <td class="py-md px-md text-on-surface-variant">10/10/2024</td>
              <td class="py-md px-md text-on-surface-variant">R$ 800,00</td>
              <td class="py-md px-md"><span class="inline-flex items-center px-2 py-1 rounded-full bg-[#ecfdf3] text-[#027a48] border border-[#a6f4c5] font-label-sm">Aprovada</span></td>
            </tr>
            <tr class="hover:bg-surface-container-low/50 transition-colors">
              <td class="py-md px-md text-on-surface font-medium">#INS-2024-0872</td>
              <td class="py-md px-md text-on-surface">Dr. Fernando Silveira</td>
              <td class="py-md px-md text-on-surface-variant">Workshop de Atualização Pediátrica</td>
              <td class="py-md px-md text-on-surface-variant">05/10/2024</td>
              <td class="py-md px-md text-on-surface-variant">R$ 450,00</td>
              <td class="py-md px-md"><span class="inline-flex items-center px-2 py-1 rounded-full bg-primary-container text-on-primary-container border border-primary font-label-sm">Paga</span></td>
            </tr>
            <tr class="hover:bg-surface-container-low/50 transition-colors">
              <td class="py-md px-md text-on-surface font-medium">#INS-2024-0860</td>
              <td class="py-md px-md text-on-surface">Luciana Martins</td>
              <td class="py-md px-md text-on-surface-variant">Curso Básico de Excel para Saúde</td>
              <td class="py-md px-md text-on-surface-variant">02/10/2024</td>
              <td class="py-md px-md text-on-surface-variant">R$ 150,00</td>
              <td class="py-md px-md"><span class="inline-flex items-center px-2 py-1 rounded-full bg-error-container text-on-error-container border border-[#fec3c6] font-label-sm">Rejeitada</span></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="bg-surface-container-lowest py-sm px-md border-t border-outline-variant flex items-center justify-between">
        <span class="font-label-sm text-on-surface-variant">Mostrando 1 a 4 de 1.248 registros</span>
        <div class="flex gap-xs"><button class="w-8 h-8 rounded border border-outline-variant flex items-center justify-center text-on-surface-variant" disabled><span class="material-symbols-outlined text-[18px]">chevron_left</span></button><button class="w-8 h-8 rounded border border-outline-variant flex items-center justify-center text-on-surface-variant"><span class="material-symbols-outlined text-[18px]">chevron_right</span></button></div>
      </div>
    </div>
  </main>
</div>

</body>
</html>
