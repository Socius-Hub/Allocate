<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-background text-on-background font-body-md antialiased">

<%- include('partials/menu-lateral') %>

<div class="md:ml-64 min-h-screen flex flex-col">
  <%- include('partials/cabecalho') %>

  <main class="flex-1 mt-20 p-margin-mobile md:p-margin-desktop w-full max-w-[1600px] mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-lg gap-4">
      <div>
        <h2 class="font-headline-md text-headline-md font-bold text-on-surface">Perfis de Equipe</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">Gerencie e acompanhe a alocação de recursos por departamento.</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href="/usuario-novo" class="flex items-center gap-2 px-md py-2 bg-primary text-on-primary font-label-md text-label-md rounded-lg hover:bg-tertiary transition-colors"><span class="material-symbols-outlined text-[18px]">person_add</span>Novo Usuário</a>
        <select class="appearance-none bg-surface-container-lowest border border-outline-variant text-on-surface font-label-md text-label-md py-2 pl-4 pr-10 rounded-lg focus:outline-none focus:border-primary">
          <option>Todos os Departamentos</option><option>Operações Clínicas</option><option>Administração</option><option>TI e Sistemas</option><option>Financeiro</option>
        </select>
      </div>
    </div>

    <div class="bg-surface-container-lowest rounded-xl border border-outline-variant/40 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead><tr class="bg-surface-container-low border-b border-outline-variant/40">
            <th class="font-label-sm text-label-sm text-on-surface-variant py-4 px-6 font-medium">Funcionário</th>
            <th class="font-label-sm text-label-sm text-on-surface-variant py-4 px-6 font-medium">Departamento</th>
            <th class="font-label-sm text-label-sm text-on-surface-variant py-4 px-6 font-medium">Cargo</th>
            <th class="font-label-sm text-label-sm text-on-surface-variant py-4 px-6 font-medium">Status</th>
            <th class="font-label-sm text-label-sm text-on-surface-variant py-4 px-6 font-medium text-right">Ações</th>
          </tr></thead>
          <tbody class="font-body-sm text-body-sm text-on-surface divide-y divide-outline-variant/20">
            <tr class="hover:bg-surface-container-highest/30 transition-colors group cursor-pointer" onclick="location.href='/funcionario-perfil'">
              <td class="py-4 px-6"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-full bg-primary-container/20 flex items-center justify-center text-primary font-bold">AS</div><div><p class="font-medium text-on-surface">Dra. Ana Silva</p></div></div></td>
              <td class="py-4 px-6 text-on-surface-variant">Operações Clínicas</td>
              <td class="py-4 px-6 text-on-surface-variant">Chefe de Cirurgia</td>
              <td class="py-4 px-6"><span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-tertiary-fixed/30 text-tertiary font-label-sm text-label-sm"><span class="w-1.5 h-1.5 rounded-full bg-current"></span>Ativo</span></td>
              <td class="py-4 px-6 text-right"><span class="material-symbols-outlined text-on-surface-variant text-[20px] opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span></td>
            </tr>
            <tr class="hover:bg-surface-container-highest/30 transition-colors group cursor-pointer" onclick="location.href='/funcionario-perfil'">
              <td class="py-4 px-6"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-full bg-primary-container/20 flex items-center justify-center text-primary font-bold">CM</div><div><p class="font-medium text-on-surface">Carlos Mendes</p></div></div></td>
              <td class="py-4 px-6 text-on-surface-variant">TI e Sistemas</td>
              <td class="py-4 px-6 text-on-surface-variant">Analista de Sistemas Sr.</td>
              <td class="py-4 px-6"><span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-secondary-fixed/50 text-secondary font-label-sm text-label-sm"><span class="w-1.5 h-1.5 rounded-full bg-current"></span>Em Licença</span></td>
              <td class="py-4 px-6 text-right"><span class="material-symbols-outlined text-on-surface-variant text-[20px] opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span></td>
            </tr>
            <tr class="hover:bg-surface-container-highest/30 transition-colors group cursor-pointer" onclick="location.href='/funcionario-perfil'">
              <td class="py-4 px-6"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-full bg-primary-container/20 flex items-center justify-center text-primary font-bold">MR</div><div><p class="font-medium text-on-surface">Maria Rosa</p></div></div></td>
              <td class="py-4 px-6 text-on-surface-variant">Administração</td>
              <td class="py-4 px-6 text-on-surface-variant">Coordenadora de RH</td>
              <td class="py-4 px-6"><span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-tertiary-fixed/30 text-tertiary font-label-sm text-label-sm"><span class="w-1.5 h-1.5 rounded-full bg-current"></span>Ativo</span></td>
              <td class="py-4 px-6 text-right"><span class="material-symbols-outlined text-on-surface-variant text-[20px] opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span></td>
            </tr>
            <tr class="hover:bg-surface-container-highest/30 transition-colors group cursor-pointer" onclick="location.href='/funcionario-perfil'">
              <td class="py-4 px-6"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-full bg-primary-container/20 flex items-center justify-center text-primary font-bold">FC</div><div><p class="font-medium text-on-surface">Fernanda Costa</p></div></div></td>
              <td class="py-4 px-6 text-on-surface-variant">Financeiro</td>
              <td class="py-4 px-6 text-on-surface-variant">Diretora Financeira</td>
              <td class="py-4 px-6"><span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-tertiary-fixed/30 text-tertiary font-label-sm text-label-sm"><span class="w-1.5 h-1.5 rounded-full bg-current"></span>Ativo</span></td>
              <td class="py-4 px-6 text-right"><span class="material-symbols-outlined text-on-surface-variant text-[20px] opacity-0 group-hover:opacity-100 transition-opacity">chevron_right</span></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="bg-surface-container-low px-6 py-3 border-t border-outline-variant/40 flex items-center justify-between">
        <p class="font-body-sm text-body-sm text-on-surface-variant">Mostrando 1 a 4 de 128 registros</p>
        <div class="flex items-center gap-1">
          <button class="p-1 text-on-surface-variant hover:bg-surface-container-highest rounded" disabled><span class="material-symbols-outlined">chevron_left</span></button>
          <button class="w-8 h-8 flex items-center justify-center font-label-sm bg-primary text-on-primary rounded-md">1</button>
          <button class="w-8 h-8 flex items-center justify-center font-label-sm text-on-surface-variant hover:bg-surface-container-highest rounded-md">2</button>
          <button class="p-1 text-on-surface-variant hover:bg-surface-container-highest rounded"><span class="material-symbols-outlined">chevron_right</span></button>
        </div>
      </div>
    </div>
  </main>
</div>

</body>
</html>
