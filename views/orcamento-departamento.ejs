<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-background text-on-background font-body-md antialiased">

<%- include('partials/menu-lateral') %>

<div class="md:ml-64 min-h-screen flex flex-col">
  <%- include('partials/cabecalho') %>

  <main class="flex-1 mt-20 p-margin-mobile md:p-margin-desktop w-full max-w-[1600px] mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-xl gap-4">
      <div><h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-background">Orçamento por Departamento</h2><p class="font-body-lg text-body-lg text-on-surface-variant mt-2">Acompanhamento consolidado de limites, valores utilizados e disponíveis.</p></div>
      <select class="border border-outline-variant bg-surface-container-lowest rounded-lg px-4 py-2 font-body-md text-body-md text-on-surface focus:ring-primary focus:border-primary outline-none"><option>Q3 2024</option><option>Q4 2024</option><option>Q1 2025</option></select>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm md:col-span-12 p-lg flex flex-col md:flex-row justify-between items-center gap-6">
        <div><h3 class="font-headline-sm text-headline-sm text-on-background mb-1">Orçamento Total Global</h3><p class="font-body-sm text-body-sm text-on-surface-variant">Ciclo atual: Q4 2024</p></div>
        <div class="flex gap-8 w-full md:w-auto overflow-x-auto">
          <div class="flex flex-col"><span class="font-label-sm text-label-sm text-on-surface-variant uppercase">Limite Total</span><span class="font-headline-md text-headline-md text-on-background mt-1">R$ 15,4M</span></div>
          <div class="w-px h-12 bg-outline-variant hidden md:block"></div>
          <div class="flex flex-col"><span class="font-label-sm text-label-sm text-on-surface-variant uppercase">Utilizado</span><span class="font-headline-md text-headline-md text-secondary-container mt-1">R$ 10,2M</span></div>
          <div class="w-px h-12 bg-outline-variant hidden md:block"></div>
          <div class="flex flex-col"><span class="font-label-sm text-label-sm text-on-surface-variant uppercase">Disponível</span><span class="font-headline-md text-headline-md text-primary mt-1">R$ 5,2M</span></div>
        </div>
      </div>

      <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm md:col-span-8 p-lg flex flex-col h-[400px]">
        <div class="flex justify-between items-center mb-4"><h3 class="font-headline-sm text-headline-sm text-on-background">Comparativo por Área</h3></div>
        <div class="flex-grow relative w-full h-full"><canvas id="barChart"></canvas></div>
      </div>

      <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm md:col-span-4 p-lg flex flex-col h-[400px]">
        <h3 class="font-headline-sm text-headline-sm text-on-background mb-4">Distribuição de Recursos</h3>
        <div class="flex-grow relative w-full h-full flex items-center justify-center"><canvas id="doughnutChart"></canvas></div>
        <div class="mt-4 flex justify-center gap-4 flex-wrap">
          <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-full bg-primary"></div><span class="font-label-sm text-label-sm text-on-surface-variant">Clínica</span></div>
          <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-full bg-secondary-container"></div><span class="font-label-sm text-label-sm text-on-surface-variant">TI</span></div>
          <div class="flex items-center gap-2"><div class="w-3 h-3 rounded-full bg-outline-variant"></div><span class="font-label-sm text-label-sm text-on-surface-variant">RH</span></div>
        </div>
      </div>

      <div class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm md:col-span-12 p-0 overflow-hidden">
        <div class="p-lg border-b border-outline-variant"><h3 class="font-headline-sm text-headline-sm text-on-background">Áreas com Atenção</h3><p class="font-body-sm text-body-sm text-on-surface-variant mt-1">Departamentos próximos ou acima do limite orçamentário.</p></div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead><tr class="bg-surface border-b border-outline-variant font-label-md text-label-md text-on-surface-variant"><th class="py-3 px-lg font-medium">Departamento</th><th class="py-3 px-lg font-medium">Líder</th><th class="py-3 px-lg font-medium text-right">Limite</th><th class="py-3 px-lg font-medium text-right">Utilizado</th><th class="py-3 px-lg font-medium text-center">Status</th></tr></thead>
            <tbody class="font-body-sm text-body-sm text-on-background">
              <tr class="border-b border-outline-variant"><td class="py-4 px-lg font-medium">Tecnologia (TI)</td><td class="py-4 px-lg">Carlos Reis</td><td class="py-4 px-lg text-right">R$ 2,5M</td><td class="py-4 px-lg text-right">R$ 2,4M</td><td class="py-4 px-lg text-center"><span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] font-bold bg-error-container text-on-error-container">96% UTILIZADO</span></td></tr>
              <tr class="border-b border-outline-variant"><td class="py-4 px-lg font-medium">Marketing</td><td class="py-4 px-lg">Ana Silva</td><td class="py-4 px-lg text-right">R$ 1,2M</td><td class="py-4 px-lg text-right">R$ 1,0M</td><td class="py-4 px-lg text-center"><span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] font-bold bg-secondary-fixed-dim/30 text-secondary">83% UTILIZADO</span></td></tr>
              <tr><td class="py-4 px-lg font-medium">Operações Clínicas</td><td class="py-4 px-lg">Marcos Ferreira</td><td class="py-4 px-lg text-right">R$ 5,0M</td><td class="py-4 px-lg text-right">R$ 2,5M</td><td class="py-4 px-lg text-center"><span class="inline-flex items-center px-2 py-1 rounded-full text-[10px] font-bold bg-primary-container/10 text-primary">50% UTILIZADO</span></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
      const primaryColor = '#006a3f', secondaryColor = '#fc9912', outlineColor = '#bccabe';
      new Chart(document.getElementById('barChart').getContext('2d'), {
        type: 'bar',
        data: { labels: ['TI','Clínica','RH','Mkt','Pesquisa','Adm'],
          datasets: [
            { label: 'Utilizado', data: [2.4,2.5,0.8,1.0,1.5,2.0], backgroundColor: secondaryColor, borderRadius: 4 },
            { label: 'Disponível', data: [0.1,2.5,0.4,0.2,0.5,1.0], backgroundColor: primaryColor, borderRadius: 4 }
          ]},
        options: { responsive:true, maintainAspectRatio:false,
          plugins:{ legend:{position:'top', align:'end', labels:{usePointStyle:true, boxWidth:8}}},
          scales:{ x:{stacked:true, grid:{display:false}}, y:{stacked:true, ticks:{callback:v=>v+'M'}} } }
      });
      new Chart(document.getElementById('doughnutChart').getContext('2d'), {
        type: 'doughnut',
        data: { labels:['Clínica','TI','RH','Outros'], datasets:[{ data:[45,25,15,15], backgroundColor:[primaryColor, secondaryColor, outlineColor, '#d9e3fb'], borderWidth:2, borderColor:'#fff' }]},
        options: { responsive:true, maintainAspectRatio:false, cutout:'70%', plugins:{legend:{display:false}} }
      });
    });
    </script>
  </main>
</div>

</body>
</html>
