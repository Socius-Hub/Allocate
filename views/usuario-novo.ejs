<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-background text-on-background font-body-md antialiased">

<%- include('partials/menu-lateral') %>

<div class="md:ml-64 min-h-screen flex flex-col">
  <%- include('partials/cabecalho') %>

  <main class="flex-1 mt-20 p-margin-mobile md:p-margin-desktop w-full max-w-[1600px] mx-auto">
    <div class="max-w-2xl mx-auto">
      <h1 class="font-headline-md text-headline-md text-on-surface mb-xs">Novo Acesso</h1>
      <p class="font-body-sm text-body-sm text-on-surface-variant mb-lg">Preencha os dados abaixo para cadastrar um novo usuário no sistema.</p>
      <form class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm p-xl flex flex-col gap-lg" onsubmit="event.preventDefault(); location.href='/funcionarios';">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
          <div><label class="font-label-md text-label-md text-on-surface block mb-xs">Nome Completo</label><input class="w-full border border-outline-variant rounded px-md py-sm bg-surface font-body-md text-body-md focus:outline-none focus:border-primary" placeholder="Dr. João Silva" type="text"></div>
          <div><label class="font-label-md text-label-md text-on-surface block mb-xs">CRM / Matrícula</label><input class="w-full border border-outline-variant rounded px-md py-sm bg-surface font-body-md text-body-md focus:outline-none focus:border-primary" placeholder="000000-SP" type="text"></div>
        </div>
        <div><label class="font-label-md text-label-md text-on-surface block mb-xs">E-mail Corporativo</label><input class="w-full border border-outline-variant rounded px-md py-sm bg-surface font-body-md text-body-md focus:outline-none focus:border-primary" placeholder="joao.silva@unimed.coop.br" type="email"></div>
        <div><label class="font-label-md text-label-md text-on-surface block mb-xs">Perfil de Acesso</label>
          <select class="w-full border border-outline-variant rounded px-md py-sm bg-surface font-body-md text-body-md focus:outline-none focus:border-primary">
            <option>Administrador Global</option><option>Gerente de Eventos</option><option>Visualizador (Auditoria)</option><option>Equipe de Apoio</option>
          </select>
        </div>
        <div><label class="font-label-md text-label-md text-on-surface block mb-xs">Departamento / Setor</label><input class="w-full border border-outline-variant rounded px-md py-sm bg-surface font-body-md text-body-md focus:outline-none focus:border-primary" placeholder="Ex: Gestão de Recursos" type="text"></div>
        <div class="flex flex-col-reverse md:flex-row gap-md justify-end mt-md pt-md border-t border-outline-variant/30">
          <a href="/funcionarios" class="w-full md:w-auto text-center px-lg py-sm rounded border border-primary text-primary font-label-md text-label-md hover:bg-primary/5 transition-colors">Cancelar</a>
          <button class="w-full md:w-auto px-lg py-sm rounded bg-primary text-on-primary font-label-md text-label-md hover:bg-tertiary transition-colors flex items-center justify-center gap-xs" type="submit"><span class="material-symbols-outlined text-[18px]">person_add</span>Criar Usuário</button>
        </div>
      </form>
    </div>
  </main>
</div>

</body>
</html>
