<%- include('partials/app-inicio') %>
<%
const s = fmt.status(insc.status);
const pendente = insc.status === 'SOLICITADO';
const disponivelAntes = orcamento ? orcamento.limite - orcamento.utilizado : null;
const disponivelDepois = orcamento ? disponivelAntes - Number(insc.valor) : null;
%>
<div class="max-w-4xl mx-auto">
  <div class="mb-xl">
    <nav class="flex items-center gap-xs text-on-surface-variant font-label-sm mb-sm" aria-label="Trilha">
      <a class="hover:text-primary transition-colors" href="/aprovacoes">Fila de Aprovações</a><span class="material-symbols-outlined text-[16px]">chevron_right</span><span class="text-on-background">Solicitação #<%= insc.id_inscricao %></span>
    </nav>
    <div class="flex justify-between items-start flex-wrap gap-md">
      <div><h2 class="font-headline-md text-headline-md text-on-background mb-xs">Solicitação de Inscrição</h2><p class="font-body-md text-body-md text-on-surface-variant">Revise os detalhes abaixo para aprovar ou rejeitar esta alocação.</p></div>
      <span class="badge border <%= s.classe %> !text-sm !px-3 !py-1"><%= pendente ? 'Aguardando revisão' : s.rotulo %></span>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-lg mb-xl">
    <section class="md:col-span-2 cartao p-lg">
      <h3 class="font-headline-sm text-headline-sm text-on-background mb-md border-b border-outline-variant pb-sm">Detalhes da Solicitação</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-md mb-lg">
        <div><span class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Evento</span><a href="/eventos/<%= insc.id_evento %>" class="font-body-md text-body-md text-primary hover:underline"><%= insc.evento %></a></div>
        <div><span class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Data do evento</span><span class="font-body-md text-body-md text-on-background"><%= fmt.periodo(insc.data_inicio, insc.data_termino) %></span></div>
        <div><span class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Solicitado por</span><div class="flex items-center gap-sm"><div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-primary font-label-sm"><%= fmt.iniciais(insc.nome_completo) %></div><a href="/funcionarios/<%= insc.id_usuario %>" class="font-body-md text-body-md text-on-background hover:text-primary"><%= insc.nome_completo %></a></div></div>
        <div><span class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Departamento</span><span class="font-body-md text-body-md text-on-background"><%= insc.nome_depto %></span></div>
        <div><span class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Tier</span><span class="font-body-md text-body-md text-on-background"><%= insc.tier %></span></div>
        <div><span class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Data de envio</span><span class="font-body-md text-body-md text-on-background"><%= fmt.dataHora(insc.data_inscricao) %></span></div>
      </div>
      <div>
        <span class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Justificativa</span>
        <p class="font-body-md text-body-md text-on-background bg-surface-container-low p-md rounded-lg border border-outline-variant/50 whitespace-pre-line"><%= insc.justificativa || 'Não informada.' %></p>
      </div>
      <% if (insc.comentario_revisao) { %>
        <div class="mt-md">
          <span class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Comentário da revisão</span>
          <p class="font-body-md text-body-md text-on-background bg-surface-container-low p-md rounded-lg border border-outline-variant/50"><%= insc.comentario_revisao %></p>
        </div>
      <% } %>
    </section>

    <section class="cartao p-lg flex flex-col">
      <h3 class="font-headline-sm text-headline-sm text-on-background mb-md border-b border-outline-variant pb-sm">Impacto Financeiro</h3>
      <div class="mb-md"><span class="block font-label-sm text-label-sm text-on-surface-variant mb-1">Valor Solicitado</span><span class="font-display-lg-mobile text-display-lg-mobile text-primary font-bold"><%= fmt.moeda(insc.valor) %></span></div>
      <% if (orcamento) { %>
        <div class="space-y-sm">
          <p class="font-label-sm text-label-sm text-on-surface-variant">Orçamento de <%= insc.nome_depto %> · <%= orcamento.ciclo %></p>
          <div class="flex justify-between items-center py-2 border-b border-outline-variant/30"><span class="font-body-sm text-body-sm text-on-surface-variant">Limite</span><span class="font-label-md text-label-md text-on-background"><%= fmt.moeda(orcamento.limite) %></span></div>
          <div class="flex justify-between items-center py-2 border-b border-outline-variant/30"><span class="font-body-sm text-body-sm text-on-surface-variant">Disponível (agora)</span><span class="font-label-md text-label-md text-on-background"><%= fmt.moeda(disponivelAntes) %></span></div>
          <% if (pendente) { %>
            <div class="flex justify-between items-center py-2"><span class="font-body-sm text-body-sm text-on-surface-variant">Disponível (se aprovar)</span><span class="font-label-md text-label-md <%= disponivelDepois < 0 ? 'text-error' : 'text-secondary' %>"><%= fmt.moeda(disponivelDepois) %></span></div>
            <% if (disponivelDepois < 0) { %><p class="font-label-sm text-label-sm text-error flex items-center gap-xs"><span class="material-symbols-outlined text-[16px]">warning</span>A aprovação ultrapassa o limite do departamento.</p><% } %>
          <% } %>
        </div>
      <% } else { %>
        <p class="font-body-sm text-body-sm text-on-surface-variant">O departamento não possui orçamento cadastrado no ciclo ativo. A aprovação não alterará nenhum orçamento.</p>
      <% } %>
    </section>
  </div>

  <% if (pendente) { %>
    <section class="cartao p-lg">
      <h3 class="font-headline-sm text-headline-sm text-on-background mb-md">Ação de Revisão</h3>
      <form action="/aprovacoes/<%= insc.id_inscricao %>" method="POST" novalidate>
        <div class="mb-lg">
          <label class="form-label" for="comentario">Comentários / justificativa da revisão <span class="text-on-surface-variant font-normal">(obrigatório para rejeitar)</span></label>
          <textarea class="form-input <%= erros.comentario ? 'invalido' : '' %>" id="comentario" name="comentario" rows="3" maxlength="500" placeholder="Informe o motivo da aprovação ou rejeição..."><%= dados.comentario || '' %></textarea>
          <%- include('partials/erro-campo', { campo: 'comentario' }) %>
        </div>
        <div class="flex justify-end gap-md flex-wrap">
          <button name="acao" value="rejeitar" class="btn btn-perigo !rounded-full !px-xl !py-3"><span class="material-symbols-outlined">close</span>Rejeitar Solicitação</button>
          <button name="acao" value="aprovar" class="btn btn-primario !rounded-full !px-xl !py-3"><span class="material-symbols-outlined">check</span>Aprovar Solicitação</button>
        </div>
      </form>
    </section>
  <% } else { %>
    <div class="flex justify-end"><a href="/aprovacoes" class="btn btn-neutro">Voltar para a fila</a></div>
  <% } %>
</div>
<%- include('partials/app-fim') %>
