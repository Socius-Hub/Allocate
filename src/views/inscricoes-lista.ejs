<%- include('partials/app-inicio') %>
<%
const filtrosStatus = [['', 'Todos', null, contagem.TODOS], ['SOLICITADO', 'Solicitada', 'bg-secondary-container', contagem.SOLICITADO], ['APROVADO', 'Aprovada', 'bg-primary', contagem.APROVADO], ['PAGO', 'Paga', 'bg-tertiary', contagem.PAGO], ['REJEITADO', 'Rejeitada', 'bg-error', contagem.REJEITADO]];
%>
<div class="flex flex-col md:flex-row md:items-end justify-between gap-md mb-lg">
  <div>
    <h2 class="font-display-lg-mobile text-display-lg-mobile md:text-[40px] md:leading-[48px] text-on-surface"><%= titulo %></h2>
    <p class="font-body-lg text-body-lg text-on-surface-variant mt-xs"><%= isAdmin ? 'Histórico completo e gestão de status de inscrições em eventos.' : 'Acompanhe suas solicitações de inscrição em eventos.' %></p>
  </div>
  <a href="/inscricoes/nova" class="btn btn-primario"><span class="material-symbols-outlined text-[18px]">add</span>Nova Inscrição</a>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-gutter mb-xl">
  <div class="md:col-span-3 cartao p-md flex flex-wrap gap-sm items-center">
    <span class="font-label-md text-label-md text-on-surface-variant mr-sm">Filtrar por status:</span>
    <% filtrosStatus.forEach(function (f) { const ativo = status === f[0]; %>
      <a href="<%= link({ status: f[0], pagina: null }) %>" class="px-md py-xs rounded-full font-label-sm text-label-sm border flex items-center gap-xs transition-colors <%= ativo ? 'bg-surface-container-high border-outline text-on-surface font-semibold' : 'bg-surface-container-lowest border-outline-variant text-on-surface hover:bg-surface-container-low' %>">
        <% if (f[2]) { %><span class="w-2 h-2 rounded-full <%= f[2] %>"></span><% } %><%= f[1] %> (<%= f[3] %>)
      </a>
    <% }); %>
  </div>
  <div class="bg-primary-container rounded-xl p-md shadow-sm flex flex-col justify-center min-h-[100px]">
    <p class="font-label-sm text-label-sm text-on-primary-container/80">Total de Inscrições</p>
    <p class="font-headline-md text-headline-md text-on-primary-container"><%= fmt.numero(contagem.TODOS) %></p>
  </div>
</div>

<div class="cartao overflow-hidden">
  <div class="overflow-x-auto">
    <table class="tabela min-w-[760px]">
      <thead><tr><th>ID</th><th>Colaborador</th><th>Evento</th><th>Tier</th><th>Solicitada em</th><th>Valor</th><th>Status</th><th class="text-right">Ações</th></tr></thead>
      <tbody>
        <% if (!inscricoes.length) { %>
          <tr><td colspan="8" class="text-center text-on-surface-variant py-xl">Nenhuma inscrição encontrada. <a class="text-primary hover:underline" href="/inscricoes/nova">Solicitar inscrição</a></td></tr>
        <% } %>
        <% inscricoes.forEach(function (i) { const s = fmt.status(i.status); const podeExcluir = isAdmin || (i.status === 'SOLICITADO' && i.id_usuario === usuarioLogado.id_usuario); %>
          <tr>
            <td class="font-medium whitespace-nowrap">#INS-<%= String(i.id_inscricao).padStart(4, '0') %></td>
            <td><p><%= i.nome_completo %></p><p class="text-xs text-on-surface-variant"><%= i.nome_depto %></p></td>
            <td class="text-on-surface-variant"><a class="hover:text-primary" href="/eventos/<%= i.id_evento %>"><%= i.evento %></a></td>
            <td class="text-on-surface-variant"><%= i.tier %></td>
            <td class="text-on-surface-variant whitespace-nowrap"><%= fmt.data(i.data_inscricao) %></td>
            <td class="text-on-surface-variant whitespace-nowrap"><%= fmt.moeda(i.valor) %></td>
            <td><span class="badge border <%= s.classe %>" <%= i.comentario_revisao ? 'title=' + JSON.stringify('Revisão: ' + i.comentario_revisao) : '' %>><%= s.rotulo %></span></td>
            <td class="text-right whitespace-nowrap">
              <% if (isAdmin && i.status === 'SOLICITADO') { %>
                <a href="/aprovacoes/<%= i.id_inscricao %>" class="btn-icone inline-flex" title="Revisar" aria-label="Revisar inscrição"><span class="material-symbols-outlined text-[20px]">rule</span></a>
              <% } %>
              <% if (isAdmin && i.status === 'APROVADO') { %>
                <form action="/inscricoes/<%= i.id_inscricao %>/status" method="POST" class="inline">
                  <input type="hidden" name="status" value="PAGO">
                  <button class="btn-icone" title="Marcar como paga" aria-label="Marcar como paga"><span class="material-symbols-outlined text-[20px]">payments</span></button>
                </form>
              <% } %>
              <% if (podeExcluir) { %>
                <form action="/inscricoes/<%= i.id_inscricao %>/excluir" method="POST" class="inline" data-confirmar="<%= isAdmin ? 'Excluir esta inscrição?' : 'Cancelar sua inscrição neste evento?' %>">
                  <button class="btn-icone perigo" title="<%= isAdmin ? 'Excluir' : 'Cancelar' %>" aria-label="Excluir inscrição"><span class="material-symbols-outlined text-[20px]"><%= isAdmin ? 'delete' : 'cancel' %></span></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('partials/paginacao', { rotulo: 'registros' }) %>
</div>
<%- include('partials/app-fim') %>