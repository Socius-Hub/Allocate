<%- include('partials/app-inicio') %>
<% const s = fmt.status(evento.status); const restante = Number(evento.custo_estimado) - Number(alocado); %>
<div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-xl gap-4">
  <div class="min-w-0">
    <nav class="flex items-center gap-2 mb-2 text-on-surface-variant font-label-sm" aria-label="Trilha">
      <a class="hover:text-primary transition-colors" href="/eventos">Eventos</a>
      <span class="material-symbols-outlined text-[16px]">chevron_right</span>
      <span class="text-primary truncate"><%= evento.nome %></span>
    </nav>
    <h1 class="font-headline-md text-headline-md font-bold text-on-background"><%= evento.nome %></h1>
    <div class="flex items-center gap-4 mt-2 font-body-sm text-on-surface-variant flex-wrap">
      <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">calendar_today</span><%= fmt.periodo(evento.data_inicio, evento.data_termino) %></span>
      <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">location_on</span><%= evento.localizacao %></span>
      <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[18px]">category</span><%= evento.categoria %></span>
      <span class="badge border <%= s.classe %>"><%= s.rotulo %></span>
    </div>
  </div>
  <div class="flex flex-wrap gap-3">
    <a href="/eventos/<%= evento.id_evento %>/editar" class="btn btn-secundario"><span class="material-symbols-outlined text-[18px]">edit</span>Editar</a>
    <form action="/eventos/<%= evento.id_evento %>/excluir" method="POST" data-confirmar="Excluir este evento? Os tiers e as <%= inscricoes.length %> inscrição(ões) também serão excluídos.">
      <button class="btn btn-perigo"><span class="material-symbols-outlined text-[18px]">delete</span>Excluir</button>
    </form>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
  <section class="cartao p-lg lg:col-span-2">
    <h2 class="font-headline-sm text-headline-sm font-semibold mb-md text-on-surface">Visão Geral do Evento</h2>
    <p class="font-body-md text-on-surface-variant mb-6 whitespace-pre-line"><%= evento.descricao || 'Sem descrição.' %></p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="p-4 bg-surface-container rounded-lg"><span class="block text-on-surface-variant font-label-sm mb-1">Orçamento Total</span><span class="font-headline-sm text-[20px] text-primary font-bold"><%= fmt.moedaCurta(evento.custo_estimado) %></span></div>
      <div class="p-4 bg-surface-container rounded-lg"><span class="block text-on-surface-variant font-label-sm mb-1">Alocado</span><span class="font-headline-sm text-[20px] text-on-surface font-bold"><%= fmt.moedaCurta(alocado) %></span></div>
      <div class="p-4 bg-surface-container rounded-lg"><span class="block text-on-surface-variant font-label-sm mb-1">Restante</span><span class="font-headline-sm text-[20px] font-bold <%= restante < 0 ? 'text-error' : 'text-secondary' %>"><%= fmt.moedaCurta(restante) %></span></div>
      <div class="p-4 bg-surface-container rounded-lg"><span class="block text-on-surface-variant font-label-sm mb-1">Participantes</span><span class="font-headline-sm text-[20px] text-on-surface font-bold"><%= evento.inscritos %> / <%= evento.capacidade %></span></div>
    </div>
    <% if (evento.nome_depto) { %><p class="font-body-sm text-body-sm text-on-surface-variant mt-md">Centro de custo: <strong><%= evento.nome_depto %></strong></p><% } %>
  </section>

  <section class="cartao p-lg">
    <h2 class="font-headline-sm text-headline-sm font-semibold mb-md text-on-surface">Disponibilidade de Tiers</h2>
    <div class="space-y-3">
      <% if (!tiers.length) { %><p class="font-body-sm text-body-sm text-on-surface-variant">Nenhum tier cadastrado. Sem tiers não é possível receber inscrições.</p><% } %>
      <% tiers.forEach(function (t) { const livres = t.capacidade - t.inscritos; %>
        <div class="p-3 border border-outline-variant/50 rounded-lg flex justify-between items-center gap-sm bg-surface">
          <div class="min-w-0"><span class="block font-label-md text-on-surface font-bold truncate"><%= t.nome %></span><span class="font-label-sm text-on-surface-variant"><%= fmt.moeda(t.preco) %> · <%= fmt.status(t.status).rotulo %></span></div>
          <div class="text-right shrink-0"><span class="block font-headline-sm text-[20px] <%= livres <= 0 ? 'text-error' : 'text-primary' %>"><%= t.inscritos %>/<%= t.capacidade %></span><span class="font-label-sm <%= livres <= 0 ? 'text-error' : 'text-secondary' %>"><%= livres <= 0 ? 'Preenchido' : livres + ' vaga(s)' %></span></div>
        </div>
      <% }); %>
    </div>
    <a href="/eventos/<%= evento.id_evento %>/tiers" class="btn btn-neutro w-full mt-4"><span class="material-symbols-outlined text-[18px]">tune</span>Gerenciar Tiers</a>
  </section>

  <section class="cartao lg:col-span-3 overflow-hidden">
    <div class="p-lg flex justify-between items-center border-b border-outline-variant/30 bg-surface">
      <h2 class="font-headline-sm text-headline-sm font-semibold text-on-surface">Participantes Inscritos</h2>
      <% if (evento.status === 'ATIVO') { %>
        <a href="/inscricoes/nova?evento=<%= evento.id_evento %>" class="btn btn-secundario btn-sm"><span class="material-symbols-outlined text-[18px]">add</span>Adicionar</a>
      <% } %>
    </div>
    <div class="overflow-x-auto">
      <table class="tabela">
        <thead><tr><th>Funcionário</th><th>Departamento</th><th>Tier</th><th>Valor</th><th>Status</th><% if (isAdmin) { %><th class="text-right">Alterar status</th><% } %></tr></thead>
        <tbody>
          <% if (!inscricoes.length) { %><tr><td colspan="6" class="text-center text-on-surface-variant py-lg">Nenhuma inscrição neste evento ainda.</td></tr><% } %>
          <% inscricoes.forEach(function (i) { const si = fmt.status(i.status); %>
            <tr>
              <td class="font-medium"><%= i.nome_completo %></td>
              <td class="text-on-surface-variant"><%= i.nome_depto %></td>
              <td><span class="px-2 py-1 bg-surface-container-high rounded text-xs font-medium"><%= i.tier %></span></td>
              <td><%= fmt.moeda(i.valor) %></td>
              <td><span class="badge border <%= si.classe %>"><%= si.rotulo %></span></td>
              <% if (isAdmin) { %>
                <td class="text-right">
                  <form action="/inscricoes/<%= i.id_inscricao %>/status" method="POST" class="inline-flex gap-xs">
                    <select name="status" class="form-input !py-1 !text-sm w-36" aria-label="Novo status">
                      <% ['SOLICITADO','APROVADO','PAGO','REJEITADO'].forEach(function (st) { %><option value="<%= st %>" <%= st === i.status ? 'selected' : '' %>><%= fmt.status(st).rotulo %></option><% }); %>
                    </select>
                    <button class="btn btn-neutro btn-sm" title="Salvar"><span class="material-symbols-outlined text-[18px]">check</span></button>
                  </form>
                </td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
</div>
<%- include('partials/app-fim') %>