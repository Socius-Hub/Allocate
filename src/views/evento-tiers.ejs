<%- include('partials/app-inicio') %>
<%
const editando = !!tierEdicao;
const cls = (campo) => 'form-input' + (erros[campo] ? ' invalido' : '');
const val = (campo) => (dados[campo] === undefined || dados[campo] === null) ? '' : dados[campo];
const capacidadeTiers = tiers.reduce(function (s, t) { return s + t.capacidade; }, 0);
%>
<div class="mb-lg">
  <nav class="flex items-center gap-2 mb-2 text-on-surface-variant font-label-sm" aria-label="Trilha">
    <a class="hover:text-primary" href="/eventos">Eventos</a><span class="material-symbols-outlined text-[16px]">chevron_right</span>
    <a class="hover:text-primary truncate" href="/eventos/<%= evento.id_evento %>"><%= evento.nome %></a><span class="material-symbols-outlined text-[16px]">chevron_right</span>
    <span class="text-primary">Tiers</span>
  </nav>
  <h1 class="font-headline-md text-headline-md text-on-background mb-xs">Gerenciar Tiers de Inscrição</h1>
  <p class="font-body-md text-body-md text-on-surface-variant">Configure categorias de inscrição, preços e vagas deste evento (capacidade do evento: <%= evento.capacidade %>).</p>
</div>

<div class="grid grid-cols-12 gap-gutter">
  <div class="col-span-12 lg:col-span-4">
    <section class="cartao p-lg relative overflow-hidden" id="formulario">
      <div class="absolute top-0 left-0 w-full h-1 bg-primary"></div>
      <h2 class="font-headline-sm text-headline-sm text-on-background mb-lg"><%= editando ? 'Editar Tier' : 'Adicionar Novo Tier' %></h2>
      <form action="/eventos/<%= evento.id_evento %>/tiers<%= editando ? '/' + tierEdicao.id_tier : '' %>" method="POST" class="space-y-md" novalidate>
        <div>
          <label class="form-label" for="nome">Nome do Tier <span class="obrigatorio">*</span></label>
          <input class="<%= cls('nome') %>" id="nome" name="nome" value="<%= val('nome') %>" placeholder="Ex: Early Bird, VIP" required maxlength="250">
          <%- include('partials/erro-campo', { campo: 'nome' }) %>
        </div>
        <div>
          <label class="form-label" for="descricao">Descrição</label>
          <input class="<%= cls('descricao') %>" id="descricao" name="descricao" value="<%= val('descricao') %>" placeholder="Ex: Acesso total + hospedagem" maxlength="250">
          <%- include('partials/erro-campo', { campo: 'descricao' }) %>
        </div>
        <div class="grid grid-cols-2 gap-md">
          <div>
            <label class="form-label" for="preco">Preço (R$) <span class="obrigatorio">*</span></label>
            <input class="<%= cls('preco') %>" id="preco" name="preco" type="number" min="0" step="0.01" value="<%= val('preco') %>" placeholder="0,00" required>
            <%- include('partials/erro-campo', { campo: 'preco' }) %>
          </div>
          <div>
            <label class="form-label" for="capacidade">Vagas <span class="obrigatorio">*</span></label>
            <input class="<%= cls('capacidade') %>" id="capacidade" name="capacidade" type="number" min="1" max="<%= evento.capacidade %>" step="1" value="<%= val('capacidade') %>" placeholder="0" required>
            <%- include('partials/erro-campo', { campo: 'capacidade' }) %>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-md">
          <div>
            <label class="form-label" for="status">Status <span class="obrigatorio">*</span></label>
            <select class="<%= cls('status') %>" id="status" name="status">
              <% statusTier.forEach(function (st) { %><option value="<%= st %>" <%= val('status') === st ? 'selected' : '' %>><%= fmt.status(st).rotulo %></option><% }); %>
            </select>
          </div>
          <div>
            <label class="form-label" for="prazo">Prazo</label>
            <input class="<%= cls('prazo') %>" id="prazo" name="prazo" type="date" value="<%= fmt.inputData(val('prazo')) %>">
            <%- include('partials/erro-campo', { campo: 'prazo' }) %>
          </div>
        </div>
        <div class="flex gap-sm">
          <% if (editando) { %><a href="/eventos/<%= evento.id_evento %>/tiers" class="btn btn-neutro flex-1">Cancelar</a><% } %>
          <button class="btn btn-primario flex-1" type="submit"><span class="material-symbols-outlined text-[18px]">save</span><%= editando ? 'Salvar' : 'Adicionar Tier' %></button>
        </div>
      </form>
    </section>
  </div>

  <div class="col-span-12 lg:col-span-8">
    <section class="cartao overflow-hidden h-full flex flex-col">
      <div class="p-lg border-b border-outline-variant flex justify-between items-center gap-sm flex-wrap bg-surface-bright">
        <h2 class="font-headline-sm text-headline-sm text-on-background">Categorias do Evento</h2>
        <span class="badge border bg-surface-container-high text-on-surface-variant border-outline-variant">Vagas em tiers: <%= capacidadeTiers %></span>
      </div>
      <div class="flex-1 p-lg space-y-md">
        <% if (!tiers.length) { %>
          <div class="text-center text-on-surface-variant py-xl"><span class="material-symbols-outlined text-4xl">sell</span><p class="mt-sm">Nenhum tier cadastrado. Use o formulário ao lado para criar o primeiro.</p></div>
        <% } %>
        <% tiers.forEach(function (t) { const pct = fmt.percentual(t.inscritos, t.capacidade); const st = fmt.status(t.status); %>
          <div class="border rounded-lg p-md transition-all bg-surface <%= editando && tierEdicao.id_tier === t.id_tier ? 'border-primary ring-2 ring-primary/20' : 'border-outline-variant hover:border-primary/50' %> <%= t.status === 'ENCERRADO' ? 'opacity-75' : '' %>">
            <div class="flex justify-between items-start gap-sm mb-sm">
              <div class="min-w-0">
                <div class="flex items-center gap-sm mb-xs flex-wrap"><h3 class="font-label-md text-label-md text-on-background font-bold"><%= t.nome %></h3><span class="badge border <%= st.classe %>"><%= st.rotulo %></span></div>
                <div class="font-headline-sm text-[20px] text-primary"><%= Number(t.preco) === 0 ? 'Gratuito' : fmt.moeda(t.preco) %></div>
                <% if (t.descricao) { %><p class="font-body-sm text-body-sm text-on-surface-variant"><%= t.descricao %></p><% } %>
              </div>
              <div class="flex gap-xs shrink-0">
                <a href="/eventos/<%= evento.id_evento %>/tiers?editar=<%= t.id_tier %>#formulario" class="btn-icone" title="Editar" aria-label="Editar tier <%= t.nome %>"><span class="material-symbols-outlined text-[20px]">edit</span></a>
                <form action="/eventos/<%= evento.id_evento %>/tiers/<%= t.id_tier %>/excluir" method="POST" data-confirmar="Excluir o tier &quot;<%= t.nome %>&quot;?">
                  <button class="btn-icone perigo" title="Excluir" aria-label="Excluir tier <%= t.nome %>"><span class="material-symbols-outlined text-[20px]">delete</span></button>
                </form>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-sm mt-md pt-md border-t border-outline-variant/50">
              <div>
                <span class="font-label-sm text-label-sm text-on-surface-variant mb-xs block">Ocupação</span>
                <div class="flex items-center gap-sm"><div class="flex-1 h-1.5 bg-surface-container-high rounded-full overflow-hidden"><div class="h-full <%= pct >= 80 ? 'bg-secondary-container' : 'bg-primary' %>" style="width: <%= Math.min(pct, 100) %>%"></div></div><span class="font-body-sm text-body-sm"><%= t.inscritos %>/<%= t.capacidade %></span></div>
              </div>
              <div class="text-right">
                <span class="font-label-sm text-label-sm text-on-surface-variant mb-xs block">Prazo</span>
                <span class="font-body-sm text-body-sm flex items-center gap-xs justify-end"><span class="material-symbols-outlined text-[16px]">schedule</span><%= t.prazo ? fmt.dataCurta(t.prazo) : 'Sem prazo' %></span>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  </div>
</div>
<%- include('partials/app-fim') %>
