<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head') %>
</head>
<body class="bg-background text-on-background font-body-md antialiased">

<%- include('partials/menu-lateral') %>

<div class="md:ml-64 min-h-screen flex flex-col">
  <%- include('partials/cabecalho') %>

  <main class="flex-1 mt-20 p-margin-mobile md:p-margin-desktop w-full max-w-[1600px] mx-auto">
    <div class="flex justify-between items-start mb-xl gap-md flex-wrap">
      <div>
        <h1 class="font-headline-md text-headline-md text-on-surface">Criar Novo Evento</h1>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">Configure os detalhes logísticos e orçamentários do evento.</p>
      </div>
      <div class="flex gap-md">
        <a href="/eventos" class="px-6 py-2 rounded-lg border border-outline text-primary font-label-md text-label-md hover:bg-surface-variant transition-colors">Descartar</a>
        <button class="px-6 py-2 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-tertiary transition-colors shadow-sm">Salvar Rascunho</button>
      </div>
    </div>

    <form class="space-y-gutter max-w-4xl" onsubmit="event.preventDefault(); location.href='/eventos';">
      <section class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
        <div class="px-xl py-lg border-b border-outline-variant bg-surface flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-primary-container/20 flex items-center justify-center text-primary"><span class="material-symbols-outlined text-[18px]">info</span></div>
          <h3 class="font-headline-sm text-headline-sm text-on-surface">Informações do Evento</h3>
        </div>
        <div class="p-xl space-y-lg">
          <div><label class="block font-label-md text-label-md text-on-surface mb-xs">Nome do Evento *</label><input class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-2 font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none" placeholder="Ex: Simpósio Anual de Cardiologia" type="text" required></div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
            <div><label class="block font-label-md text-label-md text-on-surface mb-xs">Início</label><input class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-2 font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none" type="datetime-local"></div>
            <div><label class="block font-label-md text-label-md text-on-surface mb-xs">Término</label><input class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-2 font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none" type="datetime-local"></div>
          </div>
          <div><label class="block font-label-md text-label-md text-on-surface mb-xs">Local Principal</label><input class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-2 font-body-md text-body-md focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none" placeholder="Ex: Campinas HQ - Auditório A" type="text"></div>
        </div>
      </section>

      <section class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
        <div class="px-xl py-lg border-b border-outline-variant bg-surface flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-primary-container/20 flex items-center justify-center text-primary"><span class="material-symbols-outlined text-[18px]">subject</span></div>
          <h3 class="font-headline-sm text-headline-sm text-on-surface">Classificação e Detalhes</h3>
        </div>
        <div class="p-xl space-y-lg">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
            <div><label class="block font-label-md text-label-md text-on-surface mb-xs">Categoria do Evento</label>
              <select class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-2 font-body-md text-body-md focus:border-primary outline-none">
                <option>Congresso Médico</option><option>Treinamento de Equipe</option><option>Simpósio Regional</option><option>Reunião de Diretoria</option>
              </select>
            </div>
            <div><label class="block font-label-md text-label-md text-on-surface mb-xs">Capacidade Máxima</label><input class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-2 font-body-md text-body-md focus:border-primary outline-none" placeholder="0" type="number"></div>
          </div>
          <div><label class="block font-label-md text-label-md text-on-surface mb-xs">Descrição Interna</label><textarea class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-2 font-body-md text-body-md focus:border-primary outline-none" rows="4" placeholder="Contexto ou requisitos específicos para este evento..."></textarea></div>
        </div>
      </section>

      <section class="bg-surface-container-lowest rounded-xl border border-outline-variant shadow-sm overflow-hidden">
        <div class="px-xl py-lg border-b border-outline-variant bg-surface flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-primary-container/20 flex items-center justify-center text-primary"><span class="material-symbols-outlined text-[18px]">account_balance_wallet</span></div>
          <h3 class="font-headline-sm text-headline-sm text-on-surface">Orçamento Inicial</h3>
        </div>
        <div class="p-xl space-y-lg">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
            <div><label class="block font-label-md text-label-md text-on-surface mb-xs">Custo Estimado (R$)</label><input class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-2 font-body-md text-body-md focus:border-primary outline-none" placeholder="0,00" type="text"></div>
            <div><label class="block font-label-md text-label-md text-on-surface mb-xs">Centro de Custo</label>
              <select class="w-full rounded-lg border border-outline-variant bg-surface px-4 py-2 font-body-md text-body-md focus:border-primary outline-none">
                <option>Recursos Humanos (HR-001)</option><option>Educação Continuada (CE-204)</option><option>Operações Gerais (OP-992)</option>
              </select>
            </div>
          </div>
        </div>
      </section>

      <div class="flex items-center justify-end gap-md pt-lg border-t border-outline-variant">
        <a href="/eventos" class="px-6 py-2.5 rounded-lg border border-outline-variant text-on-surface font-label-md text-label-md hover:bg-surface-variant transition-colors">Cancelar</a>
        <button class="px-8 py-2.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md hover:bg-tertiary transition-colors shadow-sm flex items-center gap-2" type="submit"><span class="material-symbols-outlined text-[18px]">add_task</span>Criar Evento</button>
      </div>
    </form>
  </main>
</div>

</body>
</html>
