<%- include('partials/publico-inicio') %>
<div class="bg-surface-container min-h-full flex items-center justify-center py-xxl px-margin-mobile">
  <section class="w-full max-w-md bg-surface-container-lowest rounded-xl shadow-lg border border-outline-variant p-xl text-center">
    <span class="material-symbols-outlined text-error text-5xl mb-md"><%= status === 403 ? 'block' : 'error' %></span>
    <h1 class="font-headline-md text-headline-md text-on-surface mb-xs"><%= status === 403 ? 'Acesso negado' : 'Algo deu errado' %></h1>
    <p class="font-body-md text-body-md text-on-surface-variant mb-lg"><%= mensagem %></p>
    <div class="flex flex-wrap justify-center gap-sm">
      <button type="button" onclick="history.back()" class="btn btn-neutro">Voltar</button>
      <a href="<%= usuarioLogado ? '/dashboard' : '/' %>" class="btn btn-primario"><%= usuarioLogado ? 'Ir ao painel' : 'Ir para o início' %></a>
    </div>
  </section>
</div>
<%- include('partials/publico-fim') %>