<%- include('partials/publico-inicio') %>
<div class="bg-surface-container min-h-full flex items-center justify-center py-xl px-margin-mobile">
  <section class="w-full max-w-md bg-surface-container-lowest rounded-xl shadow-lg border border-outline-variant p-lg md:p-xl">
    <div class="text-center mb-lg">
      <div class="inline-flex items-center justify-center w-12 h-12 bg-primary-container rounded-full mb-md text-on-primary-container">
        <span class="material-symbols-outlined" style="font-size:28px;">medical_services</span>
      </div>
      <h1 class="font-headline-md text-headline-md text-on-surface mb-xs">Entrar no Allocate</h1>
      <p class="font-body-md text-body-md text-on-surface-variant">Gestão de Orçamentos</p>
    </div>

    <% if (query.saiu) { %>
      <div class="flex items-center gap-sm px-md py-sm mb-lg rounded-lg border bg-[#ecfdf3] border-[#a6f4c5] text-[#027a48]"><span class="material-symbols-outlined text-[20px]">check_circle</span><p class="font-body-sm text-body-sm">Você saiu da sua conta.</p></div>
    <% } %>
    <%- include('partials/flash') %>
    <% if (locals.erroGeral) { %>
      <div class="flex items-center gap-sm px-md py-sm mb-lg rounded-lg border bg-error-container border-error/30 text-on-error-container" role="alert"><span class="material-symbols-outlined text-[20px]">error</span><p class="font-body-sm text-body-sm"><%= erroGeral %></p></div>
    <% } %>

    <form action="/login" method="POST" class="space-y-lg">
      <input type="hidden" name="voltar" value="<%= voltar %>">
      <div>
        <label class="form-label" for="email">E-mail corporativo</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">mail</span>
          <input class="form-input form-input-icone <%= erros.email ? 'invalido' : '' %>" id="email" name="email" value="<%= dados.email || '' %>" placeholder="seu.nome@empresa.com.br" required type="email" autocomplete="email" autofocus>
        </div>
        <%- include('partials/erro-campo', { campo: 'email' }) %>
      </div>
      <div>
        <label class="form-label" for="senha">Senha</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">lock</span>
          <input class="form-input form-input-icone <%= erros.senha ? 'invalido' : '' %>" id="senha" name="senha" placeholder="••••••••" required type="password" autocomplete="current-password">
        </div>
        <%- include('partials/erro-campo', { campo: 'senha' }) %>
      </div>
      <button class="btn btn-primario w-full py-2.5" type="submit">Entrar</button>
    </form>

    <div class="mt-lg pt-lg border-t border-outline-variant/40 text-center font-body-sm text-body-sm text-on-surface-variant space-y-xs">
      <p>Ainda não tem conta? <a href="/registro" class="text-primary font-medium hover:underline">Cadastre-se</a></p>
      <p class="flex items-center justify-center gap-xs"><span class="material-symbols-outlined text-[16px]">lock</span>Conexão segura. Acesso restrito a colaboradores autorizados.</p>
    </div>
  </section>
</div>
<%- include('partials/publico-fim') %>