<%- include('partials/app-inicio') %>
<%
const abas = [['', 'Todos', contagem.TODOS], ['ATIVO', 'Ativos', contagem.ATIVO], ['PLANEJAMENTO', 'Planejamento', contagem.PLANEJAMENTO], ['CONCLUIDO', 'Concluídos', contagem.CONCLUIDO], ['CANCELADO', 'Cancelados', contagem.CANCELADO]];
%>
<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-md mb-lg">
  <div>
    <h2 class="font-headline-md text-headline-md font-bold text-on-surface">Eventos</h2>
    <p class="font-body-md text-body-md text-on-surface-variant mt-1">Cadastre, edite e acompanhe os eventos e seus orçamentos.</p>
  </div>
  <a href="/eventos/novo" class="btn btn-primario"><span class="material-symbols-outlined text-[18px]">add</span>Novo Evento</a>
</div>

<section class="flex flex-col xl:flex-row justify-between items-start xl:items-center gap-md mb-lg">
  <div class="flex overflow-x-auto w-full xl:w-auto gap-sm pb-1">
    <% abas.forEach(function (a) { const ativo = filtros.status === a[0]; %>
      <a href="<%= link({ status: a[0], pagina: null }) %>" class="px-md py-1.5 font-label-md text-label-md rounded-full whitespace-nowrap transition-colors <%= ativo ? 'bg-primary text-white shadow-sm' : 'bg-surface text-on-surface-variant border border-outline-variant hover:bg-surface-container-low' %>"><%= a[1] %> (<%= a[2] %>)</a>
    <% }); %>
  </div>
  <form method="GET" action="/eventos" class="flex flex-wrap items-center gap-sm w-full xl:w-auto">
    <input type="hidden" name="status" value="<%= filtros.status %>">
    <input class="form-input sm:w-48" name="busca" value="<%= filtros.busca %>" placeholder="Buscar..." type="search" aria-label="Buscar evento">
    <select class="form-input sm:w-48" name="categoria" aria-label="Categoria" onchange="this.form.submit()">
      <option value="">Todas Categorias</option>
      <% categorias.forEach(function (c) { %><option value="<%= c.id_cat_evento %>" <%= filtros.id_cat_evento === c.id_cat_evento ? 'selected' : '' %>><%= c.categoria %></option><% }); %>
    </select>
    <input class="form-input sm:w-44" type="date" name="data" value="<%= filtros.data %>" aria-label="A partir da data" title="Eventos a partir desta data" onchange="this.form.submit()">
    <button class="btn btn-neutro" type="submit"><span class="material-symbols-outlined text-[18px]">filter_list</span>Filtrar</button>
    <% if (filtros.busca || filtros.id_cat_evento || filtros.data) { %><a class="btn btn-neutro" href="/eventos">Limpar</a><% } %>
  </form>
</section>

<div class="cartao overflow-hidden">
  <div class="overflow-x-auto">
    <table class="tabela min-w-[800px]">
      <thead><tr><th>Nome do Evento</th><th>Data</th><th>Categoria</th><th>Inscritos</th><th>Status</th><th>Orçamento</th><th class="text-right">Ações</th></tr></thead>
      <tbody>
        <% if (!eventos.length) { %>
          <tr><td colspan="7" class="text-center text-on-surface-variant py-xl">Nenhum evento encontrado. <a href="/eventos/novo" class="text-primary hover:underline">Criar o primeiro</a></td></tr>
        <% } %>
        <% eventos.forEach(function (e) { const s = fmt.status(e.status); const fechado = e.status === 'CONCLUIDO' || e.status === 'CANCELADO'; %>
          <tr class="linha-clicavel <%= fechado ? 'opacity-70' : '' %>" onclick="location.href='/eventos/<%= e.id_evento %>'">
            <td><p class="font-medium text-on-surface <%= e.status === 'CANCELADO' ? 'line-through' : '' %>"><%= e.nome %></p><p class="text-on-surface-variant text-xs mt-0.5"><%= e.localizacao %></p></td>
            <td class="text-on-surface-variant whitespace-nowrap"><%= fmt.dataCurta(e.data_inicio) %></td>
            <td class="text-on-surface-variant"><%= e.categoria %></td>
            <td class="text-on-surface-variant"><%= e.inscritos %> / <%= e.capacidade %></td>
            <td><span class="badge border <%= s.classe %>"><%= s.rotulo %></span></td>
            <td class="font-medium text-on-surface whitespace-nowrap"><%= fmt.moeda(e.custo_estimado) %></td>
            <td class="text-right whitespace-nowrap" onclick="event.stopPropagation()">
              <a href="/eventos/<%= e.id_evento %>/editar" class="btn-icone inline-flex" title="Editar" aria-label="Editar <%= e.nome %>"><span class="material-symbols-outlined text-[20px]">edit</span></a>
              <form action="/eventos/<%= e.id_evento %>/excluir" method="POST" class="inline" data-confirmar="Excluir o evento &quot;<%= e.nome %>&quot;? Os tiers e inscrições dele também serão excluídos.">
                <button class="btn-icone perigo" title="Excluir" aria-label="Excluir <%= e.nome %>"><span class="material-symbols-outlined text-[20px]">delete</span></button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('partials/paginacao', { rotulo: 'eventos' }) %>
</div>
<%- include('partials/app-fim') %>
