<%- include('partials/app-inicio') %>
<%
const s = fmt.status(u.status);
const pct = orcamento ? fmt.percentual(orcamento.utilizado, orcamento.limite) : 0;
const proprio = u.id_usuario === usuarioLogado.id_usuario;
%>
<div class="mb-lg flex flex-col gap-xs">
  <% if (isAdmin) { %>
    <nav class="flex items-center gap-xs text-on-surface-variant font-label-sm" aria-label="Trilha">
      <a class="hover:text-primary transition-colors" href="/funcionarios">Perfis de Equipe</a><span class="material-symbols-outlined text-[14px]">chevron_right</span><span class="text-on-surface"><%= u.nome_completo %></span>
    </nav>
  <% } %>
  <div class="flex justify-between items-end flex-wrap gap-md">
    <div>
      <h2 class="font-display-lg-mobile text-display-lg-mobile md:text-[40px] md:leading-[48px] text-on-background"><%= u.nome_completo %><%= proprio ? ' (você)' : '' %></h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant"><%= u.nome_depto %> · <%= u.crm_matricula %></p>
    </div>
    <div class="flex items-center gap-sm flex-wrap">
      <span class="badge border <%= s.classe %>"><%= s.rotulo %></span>
      <% if (isAdmin) { %>
        <a href="/funcionarios/<%= u.id_usuario %>/editar" class="btn btn-secundario btn-sm"><span class="material-symbols-outlined text-[18px]">edit</span>Editar</a>
        <% if (!proprio) { %>
          <form action="/funcionarios/<%= u.id_usuario %>/excluir" method="POST" data-confirmar="Excluir este usuário? As inscrições dele também serão excluídas.">
            <button class="btn btn-perigo btn-sm"><span class="material-symbols-outlined text-[18px]">delete</span>Excluir</button>
          </form>
        <% } %>
      <% } else if (proprio) { %>
        <a href="/configuracoes" class="btn btn-neutro btn-sm"><span class="material-symbols-outlined text-[18px]">key</span>Alterar senha</a>
      <% } %>
    </div>
  </div>
</div>

<div class="grid grid-cols-12 gap-gutter">
  <section class="col-span-12 md:col-span-4 cartao p-lg flex flex-col gap-md">
    <div class="flex items-center gap-md border-b border-outline-variant pb-md">
      <div class="w-20 h-20 shrink-0 rounded-full bg-primary-container/20 text-primary flex items-center justify-center font-headline-sm text-headline-sm border-2 border-surface-container-highest"><%= fmt.iniciais(u.nome_completo) %></div>
      <div class="min-w-0"><h3 class="font-headline-sm text-[20px] text-on-background"><%= u.nome_completo %></h3><p class="font-body-sm text-body-sm text-on-surface-variant"><%= u.cargo || 'Cargo não informado' %></p><p class="font-label-sm text-label-sm text-primary mt-1"><%= u.perfil %></p></div>
    </div>
    <div class="flex flex-col gap-sm pt-sm font-body-sm text-body-sm text-on-surface-variant">
      <div class="flex items-center gap-sm"><span class="material-symbols-outlined text-[20px]">mail</span><span class="break-all"><%= u.email %></span></div>
      <div class="flex items-center gap-sm"><span class="material-symbols-outlined text-[20px]">call</span><%= u.telefone %></div>
      <div class="flex items-center gap-sm"><span class="material-symbols-outlined text-[20px]">business</span><%= u.nome_depto %></div>
      <div class="flex items-center gap-sm"><span class="material-symbols-outlined text-[20px]">schedule</span>Último acesso: <%= u.ultimo_login ? fmt.dataHora(u.ultimo_login) : 'nunca' %></div>
      <div class="flex items-center gap-sm"><span class="material-symbols-outlined text-[20px]">calendar_month</span>Cadastrado em <%= fmt.data(u.criado_em) %></div>
    </div>
  </section>

  <section class="col-span-12 md:col-span-8 cartao p-lg">
    <h3 class="font-headline-sm text-headline-sm text-on-background mb-lg flex items-center gap-sm"><span class="material-symbols-outlined text-primary">account_balance_wallet</span>Orçamento do Departamento <%= orcamento ? '(' + orcamento.ciclo + ')' : '' %></h3>
    <% if (orcamento) { %>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-md mb-lg">
        <div class="bg-surface-container-low p-md rounded-lg border border-outline-variant/50"><p class="font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Limite</p><p class="font-headline-sm text-headline-sm text-on-surface"><%= fmt.moedaCurta(orcamento.limite) %></p></div>
        <div class="bg-surface-container-low p-md rounded-lg border border-outline-variant/50"><p class="font-label-sm text-label-sm text-on-surface-variant uppercase mb-1">Utilizado</p><p class="font-headline-sm text-headline-sm text-secondary"><%= fmt.moedaCurta(orcamento.utilizado) %></p></div>
        <div class="bg-primary-container/10 p-md rounded-lg border border-primary/20"><p class="font-label-sm text-label-sm text-primary uppercase mb-1">Disponível</p><p class="font-headline-sm text-headline-sm text-primary"><%= fmt.moedaCurta(orcamento.limite - orcamento.utilizado) %></p></div>
      </div>
      <div class="flex justify-between font-label-sm text-label-sm mb-2 text-on-surface-variant"><span>Utilização atual</span><span class="font-bold text-on-surface"><%= pct %>%</span></div>
      <div class="h-3 w-full bg-surface-variant rounded-full overflow-hidden"><div class="h-full rounded-full <%= pct >= 90 ? 'bg-error' : pct >= 75 ? 'bg-secondary-container' : 'bg-primary' %>" style="width: <%= Math.min(pct, 100) %>%"></div></div>
    <% } else { %>
      <p class="font-body-sm text-body-sm text-on-surface-variant">O departamento não possui orçamento cadastrado no ciclo ativo.</p>
    <% } %>
  </section>

  <section class="col-span-12 cartao overflow-hidden">
    <div class="p-md border-b border-outline-variant flex justify-between items-center">
      <h3 class="font-headline-sm text-headline-sm text-on-background flex items-center gap-sm"><span class="material-symbols-outlined text-primary">history</span>Histórico de Eventos</h3>
      <a href="/inscricoes" class="text-primary font-label-md text-label-md hover:underline flex items-center gap-xs">Inscrições<span class="material-symbols-outlined text-sm">arrow_forward</span></a>
    </div>
    <div class="overflow-x-auto">
      <table class="tabela">
        <thead><tr><th>Evento</th><th>Data</th><th>Tier</th><th>Valor</th><th>Status</th></tr></thead>
        <tbody>
          <% if (!inscricoes.length) { %><tr><td colspan="5" class="text-center text-on-surface-variant py-lg">Nenhuma inscrição registrada.</td></tr><% } %>
          <% inscricoes.forEach(function (i) { const si = fmt.status(i.status); %>
            <tr><td class="font-medium"><%= i.evento %></td><td class="text-on-surface-variant"><%= fmt.data(i.data_inicio) %></td><td><%= i.tier %></td><td><%= fmt.moeda(i.valor) %></td><td><span class="badge border <%= si.classe %>"><%= si.rotulo %></span></td></tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>
</div>
<%- include('partials/app-fim') %>
