<%- include('partials/app-inicio') %>
<%
let custoBase = 0, adicional = 0, projetado = 0, delta = 0, capacidade = 0, rascunho = false;
if (cenario) {
  custoBase = Number(cenario.custo_base);
  adicional = Number(cenario.custo_adicional);
  projetado = custoBase + adicional;
  delta = custoBase > 0 ? (adicional / custoBase) * 100 : 0;
  // ciclo trimestral: custo mensal x 3 comparado com o limite do ciclo
  capacidade = Number(cenario.limite_total) > 0 ? Math.round((projetado * 3 / Number(cenario.limite_total)) * 100) : 0;
  rascunho = cenario.status === 'RASCUNHO';
}
%>
<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-md mb-xl">
  <div><h2 class="font-display-lg-mobile text-display-lg-mobile md:text-[40px] md:leading-[48px] text-on-background">Simulador de Orçamento</h2><p class="font-body-lg text-body-lg text-on-surface-variant mt-sm max-w-2xl">Modele o impacto financeiro de novas contratações e ajustes de tier no orçamento do ciclo.</p></div>
  <% if (cenarios.length) { %>
    <form method="GET" action="/simulador-orcamento">
      <select name="cenario" class="form-input" onchange="this.form.submit()" aria-label="Cenário">
        <% cenarios.forEach(function (c) { %><option value="<%= c.id_cenario %>" <%= cenario && cenario.id_cenario === c.id_cenario ? 'selected' : '' %>><%= c.nome_cenario %> · <%= c.ciclo %> (<%= fmt.status(c.status).rotulo %>)</option><% }); %>
      </select>
    </form>
  <% } %>
</div>

<div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
  <div class="md:col-span-8 flex flex-col gap-gutter">
    <% if (cenario) { %>
      <section class="cartao p-lg">
        <div class="flex flex-wrap items-center justify-between gap-sm mb-md">
          <h3 class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-sm"><span class="material-symbols-outlined text-primary">person_add</span>Adicionar Funcionário / Recurso</h3>
          <span class="badge border <%= fmt.status(cenario.status).classe %>"><%= fmt.status(cenario.status).rotulo %></span>
        </div>
        <% if (rascunho) { %>
          <form action="/simulador-orcamento/cenarios/<%= cenario.id_cenario %>/itens" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-md">
            <div><label class="form-label" for="funcao">Função <span class="obrigatorio">*</span></label>
              <input class="form-input" id="funcao" name="funcao" list="funcoes" required maxlength="250" placeholder="Ex: Médico Especialista">
              <datalist id="funcoes"><option value="Médico Especialista"><option value="Enfermeiro Chefe"><option value="Analista Administrativo"><option value="Técnico de TI"></datalist></div>
            <div><label class="form-label" for="tier_nivel">Nível (Tier) <span class="obrigatorio">*</span></label>
              <select class="form-input" id="tier_nivel" name="tier_nivel"><option>Tier 1</option><option>Tier 2</option><option>Tier 3</option><option>Tier 4</option></select></div>
            <div><label class="form-label" for="quantidade">Quantidade <span class="obrigatorio">*</span></label><input class="form-input" id="quantidade" name="quantidade" min="1" max="1000" step="1" type="number" value="1" required></div>
            <div><label class="form-label" for="custo_mensal_est">Custo mensal unitário (R$) <span class="obrigatorio">*</span></label><input class="form-input" id="custo_mensal_est" name="custo_mensal_est" min="0" step="0.01" type="number" placeholder="0,00" required></div>
            <div><label class="form-label" for="inicio_previsto">Início previsto</label><input class="form-input" id="inicio_previsto" name="inicio_previsto" type="month"></div>
            <div class="flex items-end"><button class="btn btn-neutro w-full" type="submit"><span class="material-symbols-outlined text-[18px]">add_circle</span>Adicionar ao Cenário</button></div>
          </form>
        <% } else { %>
          <p class="font-body-sm text-body-sm text-on-surface-variant">Este cenário está <strong><%= fmt.status(cenario.status).rotulo.toLowerCase() %></strong>. Reabra como rascunho para alterar os recursos.</p>
        <% } %>
      </section>

      <section class="cartao p-lg">
        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-md">Composição do Cenário: <%= cenario.nome_cenario %></h3>
        <div class="overflow-x-auto -mx-lg">
          <table class="tabela">
            <thead><tr><th>Recurso</th><th>Tier</th><th>Qtd</th><th>Início</th><th class="text-right">Custo Mensal</th><% if (rascunho) { %><th class="text-center">Ação</th><% } %></tr></thead>
            <tbody>
              <% if (!itens.length) { %><tr><td colspan="6" class="text-center text-on-surface-variant py-lg">Nenhum recurso adicionado.</td></tr><% } %>
              <% itens.forEach(function (it) { %>
                <tr>
                  <td><%= it.funcao %></td>
                  <td><span class="px-2 py-1 bg-surface-container-highest rounded font-medium text-xs"><%= it.tier_nivel %></span></td>
                  <td><%= it.quantidade %></td>
                  <td class="text-on-surface-variant"><%= it.inicio_previsto ? it.inicio_previsto.split('-').reverse().join('/') : '—' %></td>
                  <td class="text-right font-medium text-primary whitespace-nowrap"><%= fmt.moeda(it.quantidade * it.custo_mensal_est) %><span class="block text-xs text-on-surface-variant font-normal"><%= fmt.moeda(it.custo_mensal_est) %> / un.</span></td>
                  <% if (rascunho) { %>
                    <td class="text-center">
                      <form action="/simulador-orcamento/itens/<%= it.id_item_cenario %>/excluir" method="POST" data-confirmar="Remover este recurso do cenário?">
                        <button class="btn-icone perigo" title="Remover" aria-label="Remover <%= it.funcao %>"><span class="material-symbols-outlined text-[18px]">delete</span></button>
                      </form>
                    </td>
                  <% } %>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>

    <section class="cartao p-lg">
      <h3 class="font-headline-sm text-headline-sm text-on-surface mb-md flex items-center gap-sm"><span class="material-symbols-outlined text-primary">add_chart</span>Novo Cenário</h3>
      <% if (!ciclos.length) { %>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Cadastre um ciclo orçamentário em Configurações antes de criar cenários.</p>
      <% } else { %>
        <form action="/simulador-orcamento/cenarios" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-md items-end">
          <div class="md:col-span-2"><label class="form-label" for="nome_cenario">Nome <span class="obrigatorio">*</span></label><input class="form-input" id="nome_cenario" name="nome_cenario" required maxlength="250" placeholder="Ex: Expansão Q1"></div>
          <div><label class="form-label" for="id_ciclo">Ciclo <span class="obrigatorio">*</span></label><select class="form-input" id="id_ciclo" name="id_ciclo"><% ciclos.forEach(function (c) { %><option value="<%= c.id_ciclo %>"><%= c.nome %></option><% }); %></select></div>
          <div><label class="form-label" for="custo_base">Custo base mensal (R$) <span class="obrigatorio">*</span></label><input class="form-input" id="custo_base" name="custo_base" type="number" min="0" step="0.01" required placeholder="0,00"></div>
          <div class="md:col-span-4 flex justify-end"><button class="btn btn-primario"><span class="material-symbols-outlined text-[18px]">add</span>Criar Cenário</button></div>
        </form>
      <% } %>
    </section>
  </div>

  <aside class="md:col-span-4 flex flex-col gap-gutter">
    <% if (cenario) { %>
      <section class="cartao overflow-hidden flex flex-col">
        <div class="p-lg bg-surface-container-low border-b border-outline-variant"><h3 class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-sm"><span class="material-symbols-outlined text-secondary-container">monitoring</span>Impacto Total</h3></div>
        <div class="p-lg flex-1 flex flex-col gap-md">
          <div class="border border-outline-variant rounded-lg p-md"><p class="font-label-sm text-label-sm text-on-surface-variant uppercase">Custo Base Atual</p><p class="font-headline-md text-headline-md text-on-surface mt-1"><%= fmt.moedaCurta(custoBase) %> <span class="font-body-sm text-body-sm text-on-surface-variant font-normal">/mês</span></p></div>
          <div class="bg-primary-container/10 border border-primary/20 rounded-lg p-md">
            <p class="font-label-sm text-label-sm text-primary uppercase font-semibold">Novo Custo Projetado</p>
            <p class="font-headline-md text-headline-md text-primary mt-1"><%= fmt.moedaCurta(projetado) %> <span class="font-body-sm text-body-sm text-primary/70 font-normal">/mês</span></p>
            <p class="font-label-md text-label-md mt-2 flex items-center gap-xs <%= adicional > 0 ? 'text-error' : 'text-on-surface-variant' %>"><span class="material-symbols-outlined text-[16px]"><%= adicional > 0 ? 'arrow_upward' : 'remove' %></span>+<%= fmt.moeda(adicional) %> (<%= fmt.numero(delta, 1) %>%)</p>
          </div>
          <div class="pt-md border-t border-outline-variant">
            <div class="flex justify-between items-center mb-xs"><span class="font-label-sm text-label-sm text-on-surface-variant">Capacidade do ciclo <%= cenario.ciclo %> (3 meses)</span><span class="font-label-sm text-label-sm text-on-surface font-medium"><%= capacidade %>%</span></div>
            <div class="w-full bg-surface-container-high rounded-full h-2"><div class="h-2 rounded-full <%= capacidade > 100 ? 'bg-error' : capacidade >= 90 ? 'bg-secondary-container' : 'bg-primary' %>" style="width: <%= Math.min(capacidade, 100) %>%"></div></div>
            <p class="font-label-sm text-label-sm text-on-surface-variant mt-xs">Limite do ciclo: <%= fmt.moedaCurta(cenario.limite_total) %></p>
          </div>
        </div>
        <div class="p-md bg-surface-container-lowest border-t border-outline-variant flex flex-wrap gap-sm">
          <% if (isAdmin) { %>
            <% if (rascunho) { %>
              <form action="/simulador-orcamento/cenarios/<%= cenario.id_cenario %>/status" method="POST" class="flex-1"><input type="hidden" name="status" value="REJEITADO"><button class="btn btn-perigo w-full">Rejeitar</button></form>
              <form action="/simulador-orcamento/cenarios/<%= cenario.id_cenario %>/status" method="POST" class="flex-1"><input type="hidden" name="status" value="APROVADO"><button class="btn btn-primario w-full">Aprovar</button></form>
            <% } else { %>
              <form action="/simulador-orcamento/cenarios/<%= cenario.id_cenario %>/status" method="POST" class="flex-1"><input type="hidden" name="status" value="RASCUNHO"><button class="btn btn-neutro w-full">Reabrir rascunho</button></form>
            <% } %>
          <% } else { %>
            <p class="font-body-sm text-body-sm text-on-surface-variant flex-1">A aprovação do cenário é feita por um administrador.</p>
          <% } %>
          <form action="/simulador-orcamento/cenarios/<%= cenario.id_cenario %>/excluir" method="POST" class="w-full" data-confirmar="Excluir o cenário &quot;<%= cenario.nome_cenario %>&quot;?">
            <button class="btn btn-neutro w-full !text-error"><span class="material-symbols-outlined text-[18px]">delete</span>Excluir cenário</button>
          </form>
        </div>
      </section>
    <% } else { %>
      <section class="cartao p-lg text-center text-on-surface-variant"><span class="material-symbols-outlined text-4xl">calculate</span><p class="mt-sm">Nenhum cenário criado ainda. Crie o primeiro ao lado.</p></section>
    <% } %>
  </aside>
</div>
<%- include('partials/app-fim') %>
