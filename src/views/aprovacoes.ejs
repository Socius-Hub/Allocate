<%- include('partials/app-inicio') %>
<div class="flex justify-between items-end mb-lg gap-md flex-wrap">
  <div><h2 class="font-headline-md text-headline-md font-bold text-on-surface">Fila de Aprovações</h2><p class="font-body-md text-body-md text-on-surface-variant mt-1">Revise as solicitações de inscrição e o impacto no orçamento de cada departamento.</p></div>
</div>

<div class="grid grid-cols-12 gap-gutter">
  <div class="col-span-12 lg:col-span-4 flex flex-col gap-md">
    <div class="cartao p-lg">
      <h3 class="font-label-md text-label-md text-on-surface-variant mb-xs">Aprovações Pendentes</h3>
      <p class="font-display-lg text-display-lg text-on-surface"><%= total %></p>
    </div>
    <div class="cartao p-lg">
      <h3 class="font-label-md text-label-md text-on-surface-variant mb-xs">Total Solicitado</h3>
      <p class="font-headline-md text-headline-md text-on-surface mt-2"><%= fmt.moeda(totalSolicitado) %></p>
      <p class="font-label-sm text-label-sm text-on-surface-variant mt-2">Soma das inscrições aguardando revisão</p>
    </div>
    <div class="cartao p-lg">
      <h3 class="font-label-md text-label-md text-on-surface-variant mb-sm">Revisadas recentemente</h3>
      <% if (!revisadas.length) { %><p class="font-body-sm text-body-sm text-on-surface-variant">Nenhuma ainda.</p><% } %>
      <ul class="space-y-sm">
        <% revisadas.forEach(function (r) { const s = fmt.status(r.status); %>
          <li class="flex justify-between items-center gap-sm font-body-sm text-body-sm"><span class="truncate"><%= r.nome_completo %> · <%= r.evento %></span><span class="badge border <%= s.classe %>"><%= s.rotulo %></span></li>
        <% }); %>
      </ul>
    </div>
  </div>

  <section class="col-span-12 lg:col-span-8 cartao overflow-hidden flex flex-col">
    <div class="hidden md:grid grid-cols-12 gap-4 p-4 bg-surface-container-low border-b border-outline-variant font-label-sm text-label-sm text-on-surface-variant items-center">
      <div class="col-span-4">Colaborador</div><div class="col-span-4">Evento e Tier</div><div class="col-span-2 text-right">Valor</div><div class="col-span-2 text-center">Ações</div>
    </div>
    <% if (!pendentes.length) { %>
      <div class="p-xl text-center text-on-surface-variant"><span class="material-symbols-outlined text-4xl">task_alt</span><p class="mt-sm">Nenhuma solicitação pendente. Tudo em dia!</p></div>
    <% } %>
    <% pendentes.forEach(function (i) { %>
      <div class="grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-4 p-4 border-b border-outline-variant items-center hover:bg-surface-container-lowest transition-colors">
        <a href="/aprovacoes/<%= i.id_inscricao %>" class="md:col-span-4 flex items-center gap-3 min-w-0">
          <div class="w-10 h-10 shrink-0 rounded-full bg-primary-container/20 text-primary flex items-center justify-center font-bold"><%= fmt.iniciais(i.nome_completo) %></div>
          <div class="min-w-0"><p class="font-label-md text-label-md text-on-surface truncate"><%= i.nome_completo %></p><p class="font-body-sm text-body-sm text-on-surface-variant truncate"><%= i.nome_depto %></p></div>
        </a>
        <div class="md:col-span-4 min-w-0"><p class="font-body-md text-body-md text-on-surface truncate"><%= i.evento %></p><span class="inline-block mt-1 bg-surface-dim text-on-surface px-2 py-0.5 rounded text-[10px] uppercase font-bold"><%= i.tier %></span></div>
        <div class="md:col-span-2 md:text-right"><p class="font-label-md text-label-md text-on-surface"><%= fmt.moeda(i.valor) %></p></div>
        <div class="md:col-span-2 flex md:justify-center gap-2">
          <form action="/aprovacoes/<%= i.id_inscricao %>" method="POST">
            <input type="hidden" name="acao" value="aprovar">
            <button class="p-2 rounded-full bg-primary-container/20 text-primary hover:bg-primary hover:text-white transition-colors" title="Aprovar" aria-label="Aprovar"><span class="material-symbols-outlined text-[18px]">check</span></button>
          </form>
          <a href="/aprovacoes/<%= i.id_inscricao %>" class="p-2 rounded-full bg-error-container text-on-error-container hover:bg-error hover:text-white transition-colors" title="Rejeitar (informar motivo)" aria-label="Rejeitar"><span class="material-symbols-outlined text-[18px]">close</span></a>
          <a href="/aprovacoes/<%= i.id_inscricao %>" class="p-2 rounded-full bg-surface-container-high text-on-surface-variant hover:bg-surface-variant transition-colors" title="Ver detalhes" aria-label="Ver detalhes"><span class="material-symbols-outlined text-[18px]">visibility</span></a>
        </div>
      </div>
    <% }); %>
    <%- include('partials/paginacao', { rotulo: 'solicitações', link: function (m) { return '/aprovacoes?pagina=' + m.pagina; } }) %>
  </section>
</div>
<%- include('partials/app-fim') %>