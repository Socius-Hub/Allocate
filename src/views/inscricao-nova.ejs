<%- include('partials/app-inicio') %>
<% const cls = (campo) => 'form-input' + (erros[campo] ? ' invalido' : ''); %>
<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-xl gap-md">
    <div><h1 class="font-headline-md text-headline-md text-on-surface mb-xs">Nova Inscrição</h1><p class="font-body-md text-body-md text-on-surface-variant">Selecione o evento e a categoria de inscrição desejada.</p></div>
    <a href="/inscricoes" class="flex items-center gap-sm text-on-surface-variant hover:text-primary transition-colors"><span class="material-symbols-outlined text-[20px]">close</span><span class="font-label-md text-label-md hidden md:inline">Cancelar</span></a>
  </div>

  <% if (locals.erroGeral) { %>
    <div class="flex items-start gap-sm px-md py-sm mb-lg rounded-lg border bg-error-container border-error/30 text-on-error-container" role="alert"><span class="material-symbols-outlined text-[20px]">error</span><p class="font-body-sm text-body-sm pt-0.5"><%= erroGeral %></p></div>
  <% } %>

  <% if (!eventos.length) { %>
    <div class="cartao p-xl text-center text-on-surface-variant">
      <span class="material-symbols-outlined text-4xl">event_busy</span>
      <p class="mt-sm">Não há eventos com inscrições abertas no momento.</p>
      <a href="/eventos" class="btn btn-secundario mt-md">Ver eventos</a>
    </div>
  <% } else { %>
  <!-- Escolher o evento recarrega a página (GET ?evento=) para mostrar os tiers dele -->
  <form action="/inscricoes" method="POST" class="cartao p-lg md:p-xl space-y-xl" novalidate>
    <section class="space-y-md">
      <h2 class="font-headline-sm text-headline-sm text-on-surface border-b border-outline-variant pb-sm">Detalhes do Evento</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
        <div>
          <label class="form-label" for="id_evento">Evento com inscrições abertas <span class="obrigatorio">*</span></label>
          <select class="<%= cls('id_evento') %>" id="id_evento" name="id_evento" required
                  onchange="location.href = '/inscricoes/nova?evento=' + encodeURIComponent(this.value)">
            <option value="">Selecione um evento...</option>
            <% eventos.forEach(function (e) { %><option value="<%= e.id_evento %>" <%= evento && evento.id_evento === e.id_evento ? 'selected' : '' %>><%= e.nome %> — <%= fmt.dataCurta(e.data_inicio) %></option><% }); %>
          </select>
          <%- include('partials/erro-campo', { campo: 'id_evento' }) %>
        </div>
        <div>
          <label class="form-label" for="id_usuario">Participante <span class="obrigatorio">*</span></label>
          <% if (admin) { %>
            <select class="<%= cls('id_usuario') %>" id="id_usuario" name="id_usuario" required>
              <% usuarios.forEach(function (u) { %><option value="<%= u.id_usuario %>" <%= String(dados.id_usuario) === String(u.id_usuario) ? 'selected' : '' %>><%= u.nome_completo %> (<%= u.nome_depto %>)</option><% }); %>
            </select>
            <%- include('partials/erro-campo', { campo: 'id_usuario' }) %>
          <% } else { %>
            <input class="form-input bg-surface-container-low" id="id_usuario" value="<%= usuarioLogado.nome %>" disabled>
            <p class="form-ajuda">A inscrição será feita no seu nome.</p>
          <% } %>
        </div>
      </div>
    </section>

    <section class="space-y-md">
      <h2 class="font-headline-sm text-headline-sm text-on-surface border-b border-outline-variant pb-sm">Seleção de Categoria (Tier)</h2>
      <% if (!evento) { %>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Selecione um evento para ver os tiers disponíveis.</p>
      <% } else if (!tiers.length) { %>
        <p class="font-body-sm text-body-sm text-error">Este evento não possui tiers com inscrições abertas.</p>
      <% } else { %>
        <p class="font-body-sm text-body-sm text-on-surface-variant">Escolha o pacote de inscrição para <strong><%= evento.nome %></strong>.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-lg">
          <% tiers.forEach(function (t) { const livres = t.capacidade - t.inscritos; const esgotado = livres <= 0; %>
            <label class="border rounded-xl p-lg flex flex-col h-full relative transition-all has-[:checked]:border-2 has-[:checked]:border-primary has-[:checked]:bg-primary-container/5 <%= esgotado ? 'opacity-50 cursor-not-allowed border-outline-variant' : 'cursor-pointer border-outline-variant hover:border-primary' %>">
              <input type="radio" name="id_tier" value="<%= t.id_tier %>" class="absolute top-4 right-4 w-5 h-5" <%= esgotado ? 'disabled' : '' %> <%= String(dados.id_tier) === String(t.id_tier) && !esgotado ? 'checked' : '' %> required>
              <h3 class="font-headline-sm text-[20px] text-primary mb-xs pr-8"><%= t.nome %></h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant mb-md flex-1"><%= t.descricao || '' %></p>
              <span class="font-headline-md text-headline-md text-on-surface block mb-xs"><%= Number(t.preco) === 0 ? 'Gratuito' : fmt.moeda(t.preco) %></span>
              <span class="font-label-sm text-label-sm <%= esgotado ? 'text-error' : 'text-secondary' %>"><%= esgotado ? 'Esgotado' : livres + ' vaga(s)' %><%= t.prazo ? ' · até ' + fmt.data(t.prazo) : '' %></span>
            </label>
          <% }); %>
        </div>
        <%- include('partials/erro-campo', { campo: 'id_tier' }) %>
      <% } %>
    </section>

    <section class="space-y-md">
      <label class="form-label" for="justificativa">Justificativa da solicitação <span class="obrigatorio">*</span></label>
      <textarea class="<%= cls('justificativa') %>" id="justificativa" name="justificativa" rows="3" minlength="10" maxlength="500" placeholder="Explique por que este evento é importante para sua atuação..." required><%= dados.justificativa || '' %></textarea>
      <%- include('partials/erro-campo', { campo: 'justificativa' }) %>
    </section>

    <div class="pt-lg border-t border-outline-variant flex flex-col-reverse sm:flex-row sm:items-center justify-end gap-md">
      <a href="/inscricoes" class="btn btn-neutro">Cancelar</a>
      <button class="btn btn-primario" type="submit" <%= !evento || !tiers.length ? 'disabled' : '' %>>Confirmar Inscrição<span class="material-symbols-outlined text-[18px]">arrow_forward</span></button>
    </div>
  </form>
  <% } %>
</div>
<%- include('partials/app-fim') %>