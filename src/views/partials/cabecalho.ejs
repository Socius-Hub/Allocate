<header class="h-20 fixed top-0 right-0 left-0 md:left-64 z-30 bg-surface flex justify-between items-center px-margin-mobile md:px-margin-desktop border-b border-outline-variant/30">
  <div class="flex items-center gap-md w-full max-w-md min-w-0">
    <button type="button" class="md:hidden p-sm text-on-surface-variant hover:bg-surface-container rounded-full transition-colors" onclick="alternarMenu()" aria-label="Abrir menu">
      <span class="material-symbols-outlined">menu</span>
    </button>
    <p class="font-headline-sm md:font-headline-md text-headline-sm md:text-headline-md font-bold text-primary truncate"><%= locals.tituloHeader || titulo %></p>
    <form action="/eventos" method="GET" class="relative flex-1 hidden lg:block max-w-xs ml-lg" role="search">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
      <input name="busca" value="<%= locals.query && query.busca || '' %>" class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-full font-body-sm text-body-sm text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" placeholder="Buscar eventos..." type="search" aria-label="Buscar eventos">
    </form>
  </div>
  <div class="flex items-center gap-sm md:gap-md">
    <a href="/orcamento-departamento/exportar" class="hidden md:flex items-center gap-xs px-md py-2 border border-primary text-primary font-label-md text-label-md rounded-full hover:bg-primary/5 transition-colors whitespace-nowrap">
      <span class="material-symbols-outlined text-[18px]">download</span> Exportar Relatório
    </a>
    <a href="/eventos/novo" class="flex items-center gap-xs px-md py-2 bg-primary text-on-primary font-label-md text-label-md rounded-full hover:bg-[#006341] transition-colors shadow-sm whitespace-nowrap">
      <span class="material-symbols-outlined text-[18px]">add</span><span class="hidden sm:inline">Criar Evento</span>
    </a>
    <div class="h-8 w-[1px] bg-outline-variant mx-1 hidden md:block"></div>
    <% if (isAdmin) { %>
      <a href="/aprovacoes" class="p-2 text-on-surface-variant hover:bg-surface-container rounded-full transition-all" title="Fila de aprovações" aria-label="Fila de aprovações">
        <span class="material-symbols-outlined">notifications</span>
      </a>
    <% } %>
    <a href="/perfil" class="flex items-center gap-sm p-1 md:pr-3 rounded-full border border-outline-variant hover:bg-surface-container transition-all" title="Meu perfil">
      <span class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-label-sm text-label-sm font-bold"><%= fmt.iniciais(usuarioLogado.nome) %></span>
      <span class="hidden xl:flex flex-col leading-tight">
        <span class="font-label-sm text-label-sm text-on-surface"><%= usuarioLogado.nome %></span>
        <span class="text-[11px] text-on-surface-variant"><%= usuarioLogado.perfil %></span>
      </span>
    </a>
  </div>
</header>