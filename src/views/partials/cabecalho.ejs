<header class="h-20 fixed top-0 right-0 left-0 md:left-64 z-40 bg-surface flex justify-between items-center px-margin-mobile md:px-margin-desktop border-b border-outline-variant/30">
  <div class="flex items-center gap-md w-full max-w-md">
    <button class="md:hidden p-sm text-on-surface-variant hover:bg-surface-container rounded-full transition-colors">
      <span class="material-symbols-outlined">menu</span>
    </button>
    <h1 class="font-headline-md text-headline-md font-bold text-primary hidden md:block whitespace-nowrap"><%= locals.tituloHeader || titulo %></h1>
    <div class="relative flex-1 hidden lg:block max-w-xs ml-lg">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
      <input class="w-full pl-10 pr-4 py-2 bg-surface-container-low border border-outline-variant rounded-full font-body-sm text-body-sm text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all placeholder:text-outline-variant" placeholder="<%= locals.placeholderBusca || 'Buscar...' %>" type="text">
    </div>
  </div>
  <div class="flex items-center gap-sm md:gap-md">
    <a href="/orcamento-departamento" class="hidden md:flex items-center gap-xs px-md py-2 border border-primary text-primary font-label-md text-label-md rounded-full hover:bg-primary/5 transition-colors">
      <span class="material-symbols-outlined text-[18px]">download</span> Exportar Relatório
    </a>
    <a href="/evento-novo" class="flex items-center gap-xs px-md py-2 bg-primary text-on-primary font-label-md text-label-md rounded-full hover:bg-[#006341] transition-colors shadow-sm whitespace-nowrap">
      <span class="material-symbols-outlined text-[18px]">add</span> Criar Evento
    </a>
    <div class="h-8 w-[1px] bg-outline-variant mx-1 hidden md:block"></div>
    <button class="p-2 text-on-surface-variant hover:bg-surface-container rounded-full transition-all active:scale-95">
      <span class="material-symbols-outlined">notifications</span>
    </button>
    <a href="/funcionario-perfil" class="p-1 rounded-full border border-outline-variant hover:bg-surface-container transition-all active:scale-95">
      <img alt="Perfil do administrador" class="w-8 h-8 rounded-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDTEpyxC7TG72iCvwkjkueTi_5tWo-dYWpcuNEzeovTkKB-3DIw1mjBYcPHt7qDb-DGAAoKEz9wR1W3zDwcKV1E6JysOExiNckgX2fTOLMo0ZEBfL7PYBqZH0u2HJSsa2Z7kD-rkufFLDOemkZcGh_OWCBrPfN-dBhmZCkKP68cDlT16VFevuC1noVi52vrOZyeMKCy2p3NOZDXPlbC8usBo-_GKoBmpDAJsFfWmvr3WrPwJGm6hey1">
    </a>
  </div>
</header>
