<%- include('partials/app-inicio') %>
<div class="flex flex-col sm:flex-row sm:items-end justify-between mb-lg gap-4">
  <div>
    <h2 class="font-headline-md text-headline-md font-bold text-on-surface">Perfis de Equipe</h2>
    <p class="font-body-md text-body-md text-on-surface-variant mt-1">Gerencie os usuários e acompanhe a alocação por departamento.</p>
  </div>
  <a href="/funcionarios/novo" class="btn btn-primario"><span class="material-symbols-outlined text-[18px]">person_add</span>Novo Usuário</a>
</div>

<form method="GET" action="/funcionarios" class="cartao p-md flex flex-col sm:flex-row gap-sm mb-lg">
  <input class="form-input sm:max-w-xs" type="search" name="busca" value="<%= filtros.busca %>" placeholder="Buscar por nome ou e-mail..." aria-label="Buscar">
  <select class="form-input sm:max-w-xs" name="depto" onchange="this.form.submit()" aria-label="Departamento">
    <option value="">Todos os Departamentos</option>
    <% departamentos.forEach(function (d) { %><option value="<%= d.id_depto %>" <%= filtros.id_depto === d.id_depto ? 'selected' : '' %>><%= d.nome_depto %></option><% }); %>
  </select>
  <button class="btn btn-neutro" type="submit"><span class="material-symbols-outlined text-[18px]">search</span>Buscar</button>
  <% if (filtros.busca || filtros.id_depto) { %><a href="/funcionarios" class="btn btn-neutro">Limpar</a><% } %>
</form>

<div class="cartao overflow-hidden">
  <div class="overflow-x-auto">
    <table class="tabela min-w-[720px]">
      <thead><tr><th>Funcionário</th><th>Departamento</th><th>Cargo</th><th>Perfil</th><th>Status</th><th class="text-right">Ações</th></tr></thead>
      <tbody>
        <% if (!usuarios.length) { %><tr><td colspan="6" class="text-center text-on-surface-variant py-xl">Nenhum usuário encontrado.</td></tr><% } %>
        <% usuarios.forEach(function (u) { const s = fmt.status(u.status); %>
          <tr class="linha-clicavel group" onclick="location.href='/funcionarios/<%= u.id_usuario %>'">
            <td><div class="flex items-center gap-3"><div class="w-10 h-10 shrink-0 rounded-full bg-primary-container/20 flex items-center justify-center text-primary font-bold"><%= fmt.iniciais(u.nome_completo) %></div><div class="min-w-0"><p class="font-medium text-on-surface"><%= u.nome_completo %></p><p class="text-xs text-on-surface-variant truncate"><%= u.email %></p></div></div></td>
            <td class="text-on-surface-variant"><%= u.nome_depto %></td>
            <td class="text-on-surface-variant"><%= u.cargo || '—' %></td>
            <td class="text-on-surface-variant"><%= u.perfil %></td>
            <td><span class="badge border <%= s.classe %>"><%= s.rotulo %></span></td>
            <td class="text-right whitespace-nowrap" onclick="event.stopPropagation()">
              <a href="/funcionarios/<%= u.id_usuario %>/editar" class="btn-icone inline-flex" title="Editar" aria-label="Editar <%= u.nome_completo %>"><span class="material-symbols-outlined text-[20px]">edit</span></a>
              <% if (u.id_usuario !== usuarioLogado.id_usuario) { %>
                <form action="/funcionarios/<%= u.id_usuario %>/excluir" method="POST" class="inline" data-confirmar="Excluir o usuário &quot;<%= u.nome_completo %>&quot;? As inscrições dele também serão excluídas.">
                  <button class="btn-icone perigo" title="Excluir" aria-label="Excluir <%= u.nome_completo %>"><span class="material-symbols-outlined text-[20px]">delete</span></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('partials/paginacao', { rotulo: 'usuários' }) %>
</div>
<%- include('partials/app-fim') %>
